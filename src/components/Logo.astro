---
import { SITE } from 'astrowind:config';
---

<span class="flex items-center">
  <img
    src="/123-logo-500px-light.png"
    alt={SITE?.name || '123 ToDo'}
    class="h-auto dark:hidden max-w-full w-[170px] sm:w-[190px] md:w-[200px] lg:w-[230px]"
  />
  <img
    src="/123-logo-500px-dark.png"
    alt={SITE?.name || '123 ToDo'}
    class="h-auto hidden dark:block max-w-full w-[170px] sm:w-[190px] md:w-[200px] lg:w-[230px]"
  />
</span>
