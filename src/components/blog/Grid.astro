---
import Item from '~/components/blog/GridItem.astro';
import type { Post } from '~/types';

export interface Props {
  posts: Array<Post>;
}

const { posts } = Astro.props;
---

<div class="grid gap-8 row-gap-8 md:grid-cols-2 lg:grid-cols-3 -mb-6">
  {posts.map((post, index) => <Item post={post} loading={index < 3 ? 'eager' : 'lazy'} />)}
</div>
