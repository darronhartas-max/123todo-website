---
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';
import Button from '~/components/ui/Button.astro';

export interface Props {
  prevUrl?: string;
  nextUrl?: string;
  prevText?: string;
  nextText?: string;
}

const { prevUrl, nextUrl, prevText = 'Previous', nextText = 'Next' } = Astro.props;
---

{
  (prevUrl || nextUrl) && (
    <div class="container flex mt-8">
      <div class="flex flex-row mx-auto container justify-between items-center">
        <Button
          variant="secondary"
          class={`md:px-5 px-4 font-semibold ${!prevUrl ? 'invisible pointer-events-none' : ''}`}
          href={prevUrl ? getPermalink(prevUrl) : '#'}
        >
          <Icon name="tabler:chevron-left" class="w-5 h-5 mr-1" />
          <span>{prevText}</span>
        </Button>

        <Button
          variant="secondary"
          class={`md:px-5 px-4 font-semibold ${!nextUrl ? 'invisible pointer-events-none' : ''}`}
          href={nextUrl ? getPermalink(nextUrl) : '#'}
        >
          <span>{nextText}</span>
          <Icon name="tabler:chevron-right" class="w-5 h-5 ml-1" />
        </Button>
      </div>
    </div>
  )
}
