---
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import { getHomePermalink } from '~/utils/permalinks';

export interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

export interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], links = [], footNote = '', theme = 'light' } = Astro.props;
---

<footer
  class:list={[{ relative: true, dark: theme === 'dark' }, 'border-t border-gray-200 dark:border-slate-800 not-prose']}
>
  <div class="dark:bg-dark absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 dark:text-slate-300">
    <div class="grid grid-cols-12 gap-4 gap-y-8 sm:gap-8 py-8 md:py-12">
      <div class="col-span-12 lg:col-span-4">
        <div class="mb-2">
          <a class="inline-block font-bold text-xl" href={getHomePermalink()}>{SITE?.name}</a>
        </div>
        <div class="text-sm text-muted dark:text-gray-400">
          The free, privacy-first task manager with end-to-end encryption, zero tracking, and 100% offline support.
        </div>
      </div>
      {
        links.map(({ title, links }) => (
          <div class="col-span-6 md:col-span-3 lg:col-span-2">
            <div class="dark:text-gray-200 font-semibold mb-2">{title}</div>
            {links && Array.isArray(links) && links.length > 0 && (
              <ul class="text-sm">
                {links.map(({ text, href, ariaLabel }) => (
                  <li class="mb-2">
                    <a
                      class="text-muted hover:text-gray-700 hover:underline dark:text-gray-400 transition duration-150 ease-in-out"
                      href={href}
                      aria-label={ariaLabel}
                    >
                      <Fragment set:html={text} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>

    <!-- Pass It On / Social Share Callout Bar -->
    <div
      class="my-6 p-4 rounded-xl bg-slate-100 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60 flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left"
    >
      <div>
        <h4
          class="text-base font-bold text-slate-900 dark:text-white flex items-center justify-center md:justify-start gap-2"
        >
          <span>😊 If it's helped you, it might help someone else too</span>
        </h4>
        <p class="text-xs md:text-sm text-slate-600 dark:text-slate-300 mt-1">
          No hard sell — just pass it on if you think a friend or colleague might find it useful. Completely free.
        </p>
      </div>
      <div class="flex items-center gap-2 flex-wrap justify-center">
        <!-- X (Twitter) -->
        <button
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:border-slate-400 hover:text-slate-900 dark:hover:text-white transition shadow-sm cursor-pointer"
          title="Share on X (Twitter)"
          data-aw-social-share="twitter"
          data-aw-url="https://www.123todo.com"
          data-aw-text="Been using 123 ToDo to stay on top of things — it's free, no sign-up, and genuinely helps. Thought you might find it useful! 👉 www.123todo.com"
        >
          <Icon name="tabler:brand-x" class="w-4 h-4" /> Share on X
        </button>

        <!-- WhatsApp -->
        <button
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:border-green-400 hover:text-green-600 dark:hover:text-green-400 transition shadow-sm cursor-pointer"
          title="Share on WhatsApp"
          data-aw-social-share="whatsapp"
          data-aw-url="https://www.123todo.com"
          data-aw-text="Been using 123 ToDo to stay on top of things — it's free, no sign-up, and genuinely helps. Thought you might find it useful! 👉 www.123todo.com"
        >
          <Icon name="tabler:brand-whatsapp" class="w-4 h-4 text-green-500" /> WhatsApp
        </button>

        <!-- Facebook -->
        <button
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:border-blue-500 hover:text-blue-600 dark:hover:text-blue-400 transition shadow-sm cursor-pointer"
          title="Share on Facebook"
          data-aw-social-share="facebook"
          data-aw-url="https://www.123todo.com"
          data-aw-text="Been using 123 ToDo to stay on top of things — it's free, no sign-up, and genuinely helps. Thought you might find it useful! 👉 www.123todo.com"
        >
          <Icon name="tabler:brand-facebook" class="w-4 h-4 text-blue-500" /> Facebook
        </button>

        <!-- LinkedIn -->
        <button
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:border-blue-600 hover:text-blue-700 dark:hover:text-blue-400 transition shadow-sm cursor-pointer"
          title="Share on LinkedIn"
          data-aw-social-share="linkedin"
          data-aw-url="https://www.123todo.com"
          data-aw-text="Been using 123 ToDo to stay on top of things — it's free, no sign-up, and genuinely helps. Thought you might find it useful! 👉 www.123todo.com"
        >
          <Icon name="tabler:brand-linkedin" class="w-4 h-4 text-blue-600" /> LinkedIn
        </button>

        <!-- Reddit -->
        <button
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:border-orange-500 hover:text-orange-600 dark:hover:text-orange-400 transition shadow-sm cursor-pointer"
          title="Share on Reddit"
          data-aw-social-share="reddit"
          data-aw-url="https://www.123todo.com"
          data-aw-text="123 ToDo - Free Privacy-First Task Manager & Notes App"
        >
          <Icon name="tabler:brand-reddit" class="w-4 h-4 text-orange-500" /> Reddit
        </button>

        <!-- Telegram -->
        <button
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:border-sky-500 hover:text-sky-600 dark:hover:text-sky-400 transition shadow-sm cursor-pointer"
          title="Share on Telegram"
          data-aw-social-share="telegram"
          data-aw-url="https://www.123todo.com"
          data-aw-text="Been using 123 ToDo to stay on top of things — free & private! 👉 www.123todo.com"
        >
          <Icon name="tabler:brand-telegram" class="w-4 h-4 text-sky-500" /> Telegram
        </button>

        <!-- Threads -->
        <button
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:border-slate-400 hover:text-slate-900 dark:hover:text-white transition shadow-sm cursor-pointer"
          title="Share on Threads"
          data-aw-social-share="threads"
          data-aw-url="https://www.123todo.com"
          data-aw-text="Been using 123 ToDo to stay on top of things — free & private! 👉 www.123todo.com"
        >
          <Icon name="tabler:brand-threads" class="w-4 h-4" /> Threads
        </button>

        <!-- Bluesky -->
        <button
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:border-blue-400 hover:text-blue-500 transition shadow-sm cursor-pointer"
          title="Share on Bluesky"
          data-aw-social-share="bluesky"
          data-aw-url="https://www.123todo.com"
          data-aw-text="Been using 123 ToDo to stay on top of things — free & private! 👉 www.123todo.com"
        >
          <Icon name="tabler:cloud" class="w-4 h-4 text-blue-400" /> Bluesky
        </button>

        <!-- Pinterest -->
        <button
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:border-red-600 hover:text-red-600 transition shadow-sm cursor-pointer"
          title="Share on Pinterest"
          data-aw-social-share="pinterest"
          data-aw-url="https://www.123todo.com"
          data-aw-text="123 ToDo - Free Simple Task Management & Priority Matrix"
        >
          <Icon name="tabler:brand-pinterest" class="w-4 h-4 text-red-600" /> Pinterest
        </button>

        <!-- Copy Link -->
        <button
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:border-slate-400 hover:text-slate-900 dark:hover:text-white transition shadow-sm cursor-pointer"
          title="Copy Link"
          data-aw-social-share="copy-link"
          data-aw-url="https://www.123todo.com"
          data-aw-text="Been using 123 ToDo to stay on top of things — it's free, no sign-up, and genuinely helps. Thought you might find it useful! 👉 www.123todo.com"
        >
          <Icon name="tabler:copy" class="w-4 h-4" /> Copy Link
        </button>
      </div>
    </div>

    <div class="md:flex md:items-center md:justify-between py-6 md:py-8">
      {
        socialLinks?.length ? (
          <ul class="flex mb-4 md:order-1 -ml-2 md:ml-4 md:mb-0 rtl:ml-0 rtl:-mr-2 rtl:md:ml-0 rtl:md:mr-4">
            {socialLinks.map(({ ariaLabel, href, text, icon }) => (
              <li>
                <a
                  class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                  aria-label={ariaLabel}
                  href={href}
                >
                  {icon && <Icon name={icon} class="w-5 h-5" />}
                  <Fragment set:html={text} />
                </a>
              </li>
            ))}
          </ul>
        ) : (
          ''
        )
      }

      <div class="text-sm mr-4 dark:text-muted">
        <Fragment set:html={footNote} />
      </div>
    </div>
  </div>
</footer>
