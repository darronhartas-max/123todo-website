---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash, getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
  target?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
---

<header
  class:list={[
    { sticky: isSticky, relative: !isSticky, dark: isDark },
    'top-0 z-40 flex-none mx-auto w-full border-b border-gray-50/0 transition-[opacity] ease-in-out',
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <div class="absolute inset-0"></div>
  <div
    class:list={[
      'relative text-default py-3 px-5 sm:px-6 md:px-6 mx-auto w-full',
      {
        'md:flex md:justify-between': position !== 'center',
      },
      {
        'md:grid md:grid-cols-3 md:items-center': position === 'center',
      },
      {
        'max-w-7xl': !isFullWidth,
      },
    ]}
  >
    <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between']}>
      <a class="flex items-center" href={getHomePermalink()}>
        <Logo />
      </a>
      <div class="flex items-center md:hidden">
        <ToggleMenu />
      </div>
    </div>
    <nav
      class="items-center w-full md:w-auto hidden md:flex md:mx-5 text-default overflow-y-auto overflow-x-hidden md:overflow-y-visible md:overflow-x-auto md:justify-self-center px-6 sm:px-8 pt-8 pb-16 md:p-0"
      aria-label="Main navigation"
    >
      <!-- Mobile Header Brand Pill (House Colours) -->
      <div
        class="md:hidden flex items-center justify-between pb-3.5 mb-6 border-b border-slate-200/70 dark:border-slate-800/80 px-1 w-full"
      >
        <div class="flex items-center gap-2">
          <span
            class="flex items-center gap-1.5 bg-slate-100 dark:bg-slate-800/90 py-1.5 px-3 rounded-full border border-slate-200/80 dark:border-slate-700/60"
          >
            <span class="w-2 h-2 rounded-full bg-red-500 shadow-sm shadow-red-500/50"></span>
            <span class="w-2 h-2 rounded-full bg-amber-500 shadow-sm shadow-amber-500/50"></span>
            <span class="w-2 h-2 rounded-full bg-blue-500 shadow-sm shadow-blue-500/50"></span>
            <span class="text-[11px] font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider ml-1"
              >123 Method</span
            >
          </span>
        </div>
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Navigation</span
        >
      </div>

      <ul
        class="flex flex-col md:flex-row md:self-center w-full md:w-auto text-xl md:text-[0.9375rem] tracking-[0.01rem] font-medium md:justify-center space-y-2 md:space-y-0"
      >
        {
          links.map(({ text, href, target, links }) => (
            <li class={links?.length ? 'dropdown relative' : ''}>
              {links?.length ? (
                <>
                  {/* Desktop Dropdown Toggle Button */}
                  <button
                    type="button"
                    class="hidden md:flex hover:text-link dark:hover:text-white px-3.5 py-3 items-center whitespace-nowrap cursor-pointer transition-colors"
                  >
                    <span>{text}</span>
                    <Icon name="tabler:chevron-down" class="w-3.5 h-3.5 ml-1 rtl:ml-0 rtl:mr-1 opacity-70" />
                  </button>

                  {/* Mobile Group Category Header */}
                  <div class="md:hidden pt-4 pb-1.5 px-1 flex items-center gap-2.5 mt-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-400 dark:bg-slate-500" />
                    <span class="text-[11px] font-extrabold uppercase tracking-widest text-slate-400 dark:text-slate-500">
                      {text}
                    </span>
                    <div class="h-px bg-slate-200/80 dark:bg-slate-800/80 flex-1" />
                  </div>

                  {/* Submenu List (Floating Card on Desktop, Indented on Mobile) */}
                  <ul class="dropdown-menu md:backdrop-blur-md dark:md:bg-slate-900/95 md:bg-white/95 md:border md:border-slate-200/80 dark:md:border-slate-800 rounded-xl md:absolute pl-0 md:hidden font-medium md:min-w-[200px] md:shadow-xl md:p-1.5 space-y-1 bg-slate-50/90 dark:bg-slate-900/60 border border-slate-200/70 dark:border-slate-800/70 p-1.5 my-1">
                    {links.map(({ text: text2, href: href2, target: target2 }) => (
                      <li>
                        <a
                          class:list={[
                            'rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-link dark:hover:text-white py-2.5 px-3 md:px-3 flex items-center justify-between whitespace-nowrap text-[15px] md:text-sm text-slate-700 dark:text-slate-200 transition-colors',
                            {
                              'aw-link-active font-semibold text-accent dark:text-blue-400 bg-blue-50/70 dark:bg-blue-950/40':
                                href2 === currentPath,
                            },
                          ]}
                          href={href2}
                          target={target2}
                          rel={target2 === '_blank' ? 'noopener noreferrer' : undefined}
                        >
                          <span class="flex items-center gap-2.5">
                            {text2 === 'Report a Bug' && (
                              <Icon name="tabler:bug" class="w-4 h-4 text-red-500 md:hidden flex-shrink-0" />
                            )}
                            {text2 === 'Suggest Enhancement' && (
                              <Icon name="tabler:bulb" class="w-4 h-4 text-amber-500 md:hidden flex-shrink-0" />
                            )}
                            {text2 === 'Terms of Service' && (
                              <Icon name="tabler:file-text" class="w-4 h-4 text-blue-500 md:hidden flex-shrink-0" />
                            )}
                            {text2 === 'Privacy Policy' && (
                              <Icon
                                name="tabler:shield-check"
                                class="w-4 h-4 text-emerald-500 md:hidden flex-shrink-0"
                              />
                            )}
                            <span>{text2}</span>
                          </span>
                          <Icon name="tabler:chevron-right" class="w-3.5 h-3.5 text-slate-400 opacity-60 md:hidden" />
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : href?.includes('app.123todo.com') ? (
                <>
                  {/* Mobile Standout Open App Card */}
                  <a
                    class="md:hidden mt-4 p-3.5 rounded-xl bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 text-white font-bold flex items-center justify-between shadow-md shadow-blue-500/25 hover:opacity-95 active:scale-[0.99] transition-all"
                    href={href}
                    target={target}
                    rel={target === '_blank' ? 'noopener noreferrer' : undefined}
                  >
                    <div class="flex items-center gap-2.5">
                      <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse" />
                      <span class="text-[15px] font-bold tracking-tight">Open 123ToDo App</span>
                    </div>
                    <span class="text-xs bg-white/20 text-white px-2.5 py-1 rounded-lg border border-white/30 flex items-center gap-1 font-semibold">
                      Free
                      <Icon name="tabler:arrow-up-right" class="w-3.5 h-3.5" />
                    </span>
                  </a>

                  {/* Desktop Standard Open App Link */}
                  <a
                    class:list={[
                      'hidden md:flex hover:text-link dark:hover:text-white px-4 py-2.5 md:py-3 items-center whitespace-nowrap text-base md:text-[0.9375rem] transition-colors',
                      {
                        'aw-link-active font-semibold': href === currentPath,
                        'text-accent dark:text-blue-400 font-bold': href?.includes('app.123todo.com'),
                      },
                    ]}
                    href={href}
                    target={target}
                    rel={target === '_blank' ? 'noopener noreferrer' : undefined}
                  >
                    <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse mr-2" />
                    {text}
                  </a>
                </>
              ) : (
                <a
                  class:list={[
                    'rounded-xl px-3.5 py-2.5 md:py-3 flex items-center justify-between whitespace-nowrap text-[16px] md:text-[0.9375rem] transition-all',
                    'hover:bg-slate-100/90 dark:hover:bg-slate-800/80 active:bg-slate-200/70 dark:active:bg-slate-700/60',
                    {
                      'aw-link-active font-bold text-accent dark:text-blue-400 bg-blue-50/70 dark:bg-blue-950/40 border border-blue-200/50 dark:border-blue-800/40':
                        href === currentPath,
                      'font-medium text-slate-800 dark:text-slate-100': href !== currentPath,
                    },
                  ]}
                  href={href}
                  target={target}
                  rel={target === '_blank' ? 'noopener noreferrer' : undefined}
                >
                  <span class="flex items-center gap-3.5">
                    {text === 'Features' && (
                      <span class="w-2.5 h-2.5 rounded-full bg-blue-500 shadow-sm shadow-blue-500/50 md:hidden flex-shrink-0" />
                    )}
                    {text === 'User Guide' && (
                      <span class="w-2.5 h-2.5 rounded-full bg-amber-500 shadow-sm shadow-amber-500/50 md:hidden flex-shrink-0" />
                    )}
                    {text === 'Changelog' && (
                      <span class="w-2.5 h-2.5 rounded-full bg-purple-500 shadow-sm shadow-purple-500/50 md:hidden flex-shrink-0" />
                    )}
                    {text === 'About' && (
                      <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-sm shadow-emerald-500/50 md:hidden flex-shrink-0" />
                    )}
                    {text === 'Blog' && (
                      <span class="w-2.5 h-2.5 rounded-full bg-rose-500 shadow-sm shadow-rose-500/50 md:hidden flex-shrink-0" />
                    )}
                    <span class="text-base font-semibold">{text}</span>
                  </span>
                  <Icon
                    name="tabler:chevron-right"
                    class="w-4 h-4 text-slate-400 dark:text-slate-500 opacity-60 md:hidden"
                  />
                </a>
              )}
            </li>
          ))
        }
      </ul>

      <!-- Mobile Menu Footer Brand Accents & Theme Toggle -->
      <div
        class="md:hidden mt-8 pt-6 border-t border-slate-200/70 dark:border-slate-800/70 text-center text-xs text-slate-400 dark:text-slate-500 flex flex-col items-center gap-3.5 pb-12"
      >
        {
          showToggleTheme && (
            <div class="flex items-center gap-2.5 py-1.5 px-3.5 rounded-full bg-slate-100 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 mb-1">
              <span class="text-xs font-medium text-slate-500 dark:text-slate-400">Color Mode:</span>
              <ToggleTheme iconClass="w-5 h-5" />
            </div>
          )
        }
        <div class="flex items-center gap-1.5 text-xs font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
          <span class="text-slate-600 dark:text-slate-300 font-medium">Must Do</span>
          <span class="text-slate-300 dark:text-slate-600">•</span>
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
          <span class="text-slate-600 dark:text-slate-300 font-medium">Should Do</span>
          <span class="text-slate-300 dark:text-slate-600">•</span>
          <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
          <span class="text-slate-600 dark:text-slate-300 font-medium">Could Do</span>
        </div>
        <span class="text-[11px] text-slate-400 dark:text-slate-500">100% Private Client-Side Productivity</span>
      </div>
    </nav>
    <div
      class:list={[
        { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
        'hidden md:flex md:self-center items-center md:mb-0 md:static justify-end md:p-0 md:justify-self-end',
      ]}
    >
      <div class="items-center flex justify-between w-full md:w-auto">
        <div class="flex">
          {showToggleTheme && <ToggleTheme iconClass="w-6 h-6 md:w-5 md:h-5 md:inline-block" />}
          {
            showRssFeed && (
              <a
                class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                aria-label="RSS Feed"
                href={getAsset('/rss.xml')}
              >
                <Icon name="tabler:rss" class="w-5 h-5" />
              </a>
            )
          }
        </div>
        {
          actions?.length ? (
            <span class="ml-4 rtl:ml-0 rtl:mr-4">
              {actions.map((btnProps) => (
                <Button {...btnProps} class="ml-2 py-2.5 px-5.5 md:px-6 font-semibold shadow-none text-sm w-auto" />
              ))}
            </span>
          ) : (
            ''
          )
        }
      </div>
    </div>
  </div>
</header>
