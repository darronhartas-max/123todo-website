---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'About 123 ToDo — Privacy-First, Zero-Knowledge Task & Notes Engine',
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    image={{
      src: '~/assets/images/about-hero.jpg',
      alt: '123 ToDo Privacy-First Task & Notes Engine Across Devices',
    }}
  >
    <Fragment slot="title">
      About <span class="text-accent dark:text-white">123 ToDo</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="text-lg">
        The free, privacy-first task manager and voice note engine built for people who demand simplicity, zero data
        lock-in, and 100% zero-knowledge encryption over their data.
      </span>
    </Fragment>
  </Hero>

  <!-- Our Story -->
  <Content
    tagline="Our Story"
    title="Why We Built 123 ToDo"
    items={[]}
    image={{
      src: '~/assets/images/new_grab.jpg',
      alt: '123 ToDo Priority Matrix and Custom Project Workspace UI Grab',
    }}
  >
    <Fragment slot="content">
      <p class="text-lg mb-6">
        In a digital landscape where mainstream productivity apps track your activity, store unencrypted task data on
        commercial cloud servers, and charge aggressive monthly subscription fees, we asked a fundamental question: <span
          class="font-semibold text-primary dark:text-blue-400"
          >Why can't task management be fast, private, and free?</span
        >
      </p>

      <p class="text-lg mb-6">
        123 ToDo was engineered to eliminate software fatigue. We stripped away database configuration bloat,
        subscription paywalls, and intrusive tracking scripts to build an application grounded in core principles:
      </p>

      <ul class="text-lg mb-6 space-y-3 list-none">
        <li class="flex items-start gap-2">
          <span class="text-emerald-500 font-bold text-xl">✓</span>
          <span
            ><strong class="font-semibold">⚡ Fast & Offline-First:</strong> Powered by Progressive Web App (PWA) technology,
            launching in milliseconds with 100% offline capability.</span
          >
        </li>
        <li class="flex items-start gap-2">
          <span class="text-emerald-500 font-bold text-xl">✓</span>
          <span
            ><strong class="font-semibold">🛡️ 100% Zero-Knowledge Encryption:</strong> Your tasks and notes are encrypted
            client-side using AES-256-GCM before leaving your device.</span
          >
        </li>
        <li class="flex items-start gap-2">
          <span class="text-emerald-500 font-bold text-xl">✓</span>
          <span
            ><strong class="font-semibold">🎙️ Dual Skin Versatility:</strong> Seamless 1-tap toggle between structured Task
            Management and high-contrast Simple Voice Notes dictation.</span
          >
        </li>
        <li class="flex items-start gap-2">
          <span class="text-emerald-500 font-bold text-xl">✓</span>
          <span
            ><strong class="font-semibold">🎁 Free Core App:</strong> No forced account signups, no intrusive ads, and essential
            task management included free.</span
          >
        </li>
      </ul>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50/50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Dual Skins & Voice AI Dictation -->
  <Content
    isReversed
    tagline="Field & Desk Versatility"
    title="Dual Skins & Hands-Free AI Voice Dictation"
    items={[]}
    image={{
      src: '~/assets/images/Notes_grab.png',
      alt: '123 ToDo Simple Voice Notes Mode and Hands-Free Dictation Canvas UI Grab',
    }}
  >
    <Fragment slot="content">
      <p class="text-lg mb-6">
        Whether you are working at a desk or inspecting a job site in the field, 123 ToDo adapts to your environment
        through our **Dual Skin Operating System**:
      </p>

      <div class="space-y-4 mb-6 text-slate-700 dark:text-slate-300">
        <div class="p-4 bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-slate-200 dark:border-slate-700">
          <h4 class="font-bold text-primary dark:text-blue-400 mb-1">📋 Task Manager Mode</h4>
          <p class="text-sm">
            Features our structured P1–P4 priority matrix (Must Do, Should Do, Could Do, On Hold), custom color-coded
            project streams, drag-and-drop reordering, subtask checklists, and strategic due dates.
          </p>
        </div>

        <div class="p-4 bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-slate-200 dark:border-slate-700">
          <h4 class="font-bold text-amber-600 dark:text-amber-400 mb-1">🎙️ Simple Voice Notes Mode</h4>
          <p class="text-sm">
            High-contrast, large-text dictation interface designed for trade contractors, builders, and field work. Tap
            the red <strong>Talk</strong> button for continuous dictation with spoken punctuation, live voice editing commands
            (<em>"scratch that"</em>, <em>"delete last word"</em>), and hands-free submission directly into an
            Unassigned Inbox.
          </p>
        </div>
      </div>
    </Fragment>
  </Content>

  <!-- Zero-Knowledge Security & Cloud Sync -->
  <Content
    tagline="Privacy & Cloud Sync"
    title="Zero-Knowledge Security & E2EE Cloud Sync"
    items={[]}
    image={{
      src: '~/assets/images/blog-zero-knowledge.jpg',
      alt: '123 ToDo Zero-Knowledge Encryption Shield and Encrypted Device Pairing',
    }}
  >
    <Fragment slot="content">
      <p class="text-lg mb-6">
        We believe privacy is a fundamental human right. Unlike cloud services that store plaintext tasks on corporate
        servers, 123 ToDo encrypts all your data on your local device using **AES-256-GCM client-side encryption**.
        Neither 123 ToDo, Cloudflare, Google, nor third parties can read your task titles or notes.
      </p>

      <h3 class="text-xl font-bold mb-3 text-slate-900 dark:text-white">Dual Encrypted Sync Options:</h3>

      <ul class="space-y-3 text-base text-slate-700 dark:text-slate-300 mb-6">
        <li class="flex items-start gap-2">
          <span class="text-blue-500 font-bold">⚡</span>
          <span
            ><strong>123ToDo Cloud Sync (Default):</strong> Powered by Cloudflare D1 serverless edge database with 5-second
            6-digit device pairing codes. Eliminates 1-hour session expiration drops and WebKit PWA storage wipes on iOS
            devices.</span
          >
        </li>
        <li class="flex items-start gap-2">
          <span class="text-blue-500 font-bold">📁</span>
          <span
            ><strong>Google Drive AppData Sync:</strong> Syncs encrypted payloads directly to your personal Google account's
            hidden AppData folder.</span
          >
        </li>
      </ul>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50/50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Universal Importer & Zero Lock-In (Data Freedom) - Fluid Pipeline & Editorial Stream (No Tiles) -->
  <WidgetWrapper containerClass="max-w-6xl mx-auto py-12 md:py-16">
    <Headline
      tagline="Data Freedom"
      title="Universal Migration & Zero Lock-In Guarantee"
      subtitle="Switch away from subscription tools in seconds and maintain 100% data portability."
      classes={{
        container: 'max-w-3xl mx-auto text-center mb-12',
        title: 'text-3xl md:text-4xl font-bold tracking-tight mb-4 font-heading',
        subtitle: 'text-lg text-muted dark:text-slate-400',
      }}
    />

    <!-- Interactive Data Freedom Flow Strip -->
    <div
      class="mb-14 p-6 sm:p-8 rounded-2xl bg-gradient-to-r from-blue-500/5 via-primary/10 to-emerald-500/5 dark:from-blue-900/20 dark:via-slate-800/60 dark:to-emerald-900/20 border border-blue-200/60 dark:border-blue-800/40 shadow-sm backdrop-blur-sm"
    >
      <div class="flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
        <div class="flex items-center gap-4">
          <div
            class="w-12 h-12 rounded-xl bg-blue-100 dark:bg-blue-900/50 flex items-center justify-center text-blue-600 dark:text-blue-300 font-bold shrink-0 shadow-sm"
          >
            <Icon name="tabler:file-import" class="w-6 h-6" />
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider font-semibold text-blue-600 dark:text-blue-400">
              Step 1: Ingest
            </div>
            <div class="font-bold text-slate-900 dark:text-white">Import from Any App</div>
            <div class="text-xs text-muted dark:text-slate-400">Todoist, TickTick, Keep, MS To Do</div>
          </div>
        </div>

        <div class="hidden md:flex items-center text-slate-300 dark:text-slate-600">
          <Icon name="tabler:arrow-narrow-right" class="w-8 h-8" />
        </div>

        <div class="flex items-center gap-4">
          <div
            class="w-12 h-12 rounded-xl bg-emerald-100 dark:bg-emerald-900/50 flex items-center justify-center text-emerald-600 dark:text-emerald-300 font-bold shrink-0 shadow-sm"
          >
            <Icon name="tabler:shield-check" class="w-6 h-6" />
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider font-semibold text-emerald-600 dark:text-emerald-400">
              Step 2: Preserve
            </div>
            <div class="font-bold text-slate-900 dark:text-white">Zero Truncation Core</div>
            <div class="text-xs text-muted dark:text-slate-400">Unlimited text, AES-256 local encrypted</div>
          </div>
        </div>

        <div class="hidden md:flex items-center text-slate-300 dark:text-slate-600">
          <Icon name="tabler:arrow-narrow-right" class="w-8 h-8" />
        </div>

        <div class="flex items-center gap-4">
          <div
            class="w-12 h-12 rounded-xl bg-amber-100 dark:bg-amber-900/50 flex items-center justify-center text-amber-600 dark:text-amber-300 font-bold shrink-0 shadow-sm"
          >
            <Icon name="tabler:lock-open" class="w-6 h-6" />
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider font-semibold text-amber-600 dark:text-amber-400">
              Step 3: Sovereignty
            </div>
            <div class="font-bold text-slate-900 dark:text-white">100% Data Ownership</div>
            <div class="text-xs text-muted dark:text-slate-400">1-click JSON export & 24h shadow backups</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Editorial Feature Stream (Divided Rows, No Tiles) -->
    <div class="space-y-10">
      <!-- Item 1: Multi-App Importer -->
      <div class="flex flex-col md:flex-row md:items-start gap-6 pb-10 border-b border-slate-200 dark:border-slate-800">
        <div class="flex items-center gap-4 md:w-1/3 shrink-0">
          <div
            class="w-12 h-12 rounded-xl bg-blue-100 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0"
          >
            <Icon name="tabler:file-import" class="w-6 h-6" />
          </div>
          <div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white">Universal Multi-App Importer</h3>
            <span
              class="inline-block mt-1 text-xs font-semibold px-2.5 py-0.5 rounded-full bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800"
              >1-Click Migration</span
            >
          </div>
        </div>
        <div class="md:w-2/3">
          <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
            Migrate from existing task managers in seconds without losing your work history. Our built-in import wizard
            automatically parses formats, re-maps priorities (P1–P4), and reconstructs full nested subtask hierarchies.
          </p>
          <div class="flex flex-wrap gap-2 pt-1">
            <span
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700"
            >
              <span class="w-2 h-2 rounded-full bg-red-500"></span> Todoist (CSV)
            </span>
            <span
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700"
            >
              <span class="w-2 h-2 rounded-full bg-amber-500"></span> TickTick (Backup CSV)
            </span>
            <span
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700"
            >
              <span class="w-2 h-2 rounded-full bg-yellow-500"></span> Google Keep (Takeout JSON)
            </span>
            <span
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700"
            >
              <span class="w-2 h-2 rounded-full bg-blue-500"></span> Google Tasks (Takeout JSON)
            </span>
            <span
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700"
            >
              <span class="w-2 h-2 rounded-full bg-cyan-500"></span> Microsoft To Do (CSV)
            </span>
          </div>
        </div>
      </div>

      <!-- Item 2: Zero Truncation Guarantee -->
      <div class="flex flex-col md:flex-row md:items-start gap-6 pb-10 border-b border-slate-200 dark:border-slate-800">
        <div class="flex items-center gap-4 md:w-1/3 shrink-0">
          <div
            class="w-12 h-12 rounded-xl bg-emerald-100 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0"
          >
            <Icon name="tabler:notes" class="w-6 h-6" />
          </div>
          <div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white">Zero Truncation Guarantee</h3>
            <span
              class="inline-block mt-1 text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800"
              >Infinite Text Capacity</span
            >
          </div>
        </div>
        <div class="md:w-2/3">
          <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed mb-3">
            Many task tools silently cut off your task descriptions, truncate notes beyond 500 characters, or block
            typing when editing imported data. 123 ToDo has <strong>zero character limits</strong> on note fields.
          </p>
          <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-300">
            <li class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span> Store multi-page checklists, complex standard operating procedures
              (SOPs), and long meeting minutes.
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span> Full text rendering with actionable telephone numbers, email
              addresses, and clickable URLs.
            </li>
          </ul>
        </div>
      </div>

      <!-- Item 3: Zero Data Lock-In Export -->
      <div class="flex flex-col md:flex-row md:items-start gap-6 pb-10 border-b border-slate-200 dark:border-slate-800">
        <div class="flex items-center gap-4 md:w-1/3 shrink-0">
          <div
            class="w-12 h-12 rounded-xl bg-amber-100 dark:bg-amber-900/40 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0"
          >
            <Icon name="tabler:download" class="w-6 h-6" />
          </div>
          <div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white">Zero Data Lock-In Export</h3>
            <span
              class="inline-block mt-1 text-xs font-semibold px-2.5 py-0.5 rounded-full bg-amber-100 dark:bg-amber-950 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800"
              >Open Standard JSON</span
            >
          </div>
        </div>
        <div class="md:w-2/3">
          <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed mb-3">
            Your life and projects should never be held hostage by a software vendor. At any time, you can export your
            entire workspace dataset with 3 clicks (<code
              class="text-xs font-mono bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700"
              >Settings ⚙️ ➔ Export Backup Data</code
            >).
          </p>
          <p class="text-sm text-slate-500 dark:text-slate-400">
            Generates clean, human-readable, schema-valid JSON that you can inspect in any text editor, archive to
            offline drives, or ingest into custom scripts.
          </p>
        </div>
      </div>

      <!-- Item 4: 24-Hour Automated Shadow Backups -->
      <div class="flex flex-col md:flex-row md:items-start gap-6">
        <div class="flex items-center gap-4 md:w-1/3 shrink-0">
          <div
            class="w-12 h-12 rounded-xl bg-purple-100 dark:bg-purple-900/40 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0"
          >
            <Icon name="tabler:history" class="w-6 h-6" />
          </div>
          <div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white">24-Hour Shadow Backups</h3>
            <span
              class="inline-block mt-1 text-xs font-semibold px-2.5 py-0.5 rounded-full bg-purple-100 dark:bg-purple-950 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800"
              >Autonomous Safety Net</span
            >
          </div>
        </div>
        <div class="md:w-2/3">
          <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed mb-3">
            Accidents happen. That's why 123 ToDo includes an automated local snapshot engine. Every 24 hours, an
            immutable recovery checkpoint of your active and archived tasks is recorded safely inside local browser
            storage.
          </p>
          <p class="text-sm text-slate-500 dark:text-slate-400">
            Roll back your workspace to yesterday's snapshot with a single click — no internet connection or customer
            support tickets required.
          </p>
        </div>
      </div>
    </div>

    <!-- Data Sovereignty Guarantee Banner -->
    <div
      class="mt-14 p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center gap-4 text-center sm:text-left shadow-sm"
    >
      <div
        class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0"
      >
        <Icon name="tabler:shield-lock" class="w-6 h-6" />
      </div>
      <div class="text-sm text-slate-600 dark:text-slate-300">
        <strong class="text-slate-900 dark:text-white font-semibold">The 123 ToDo Data Sovereignty Promise:</strong> We never
        harvest your data, sell ads, or charge subscription fees to access or export your information. What you write stays
        yours, always.
      </div>
    </div>
  </WidgetWrapper>

  <!-- Automated Service Worker Updates -->
  <Content
    isReversed
    tagline="Reliability & PWA"
    title="Automated Updates & Offline Reliability"
    items={[]}
    image={{
      src: '~/assets/images/updates.png',
      alt: '123 ToDo Automated Version Updates & Shadow Backup Modal UI Grab',
    }}
  >
    <Fragment slot="content">
      <p class="text-lg mb-6">
        123 ToDo is engineered as a **Progressive Web App (PWA)** that installs directly onto iOS, Android, macOS, or
        Windows home screens.
      </p>

      <p class="text-lg mb-6">
        Automated background version monitoring constantly checks `version.json` and prompts you when an update is ready
        (<em>"🚀 New version available! Click to update now"</em>). The service worker reloads instantly with **zero
        downtime, zero data loss, and zero app store waiting cycles**.
      </p>

      <div
        class="p-4 bg-emerald-50 dark:bg-emerald-950/40 rounded-xl border border-emerald-200 dark:border-emerald-800 text-sm text-emerald-900 dark:text-emerald-200"
      >
        <strong>💡 Persistent Storage Guarantee:</strong> 123 ToDo uses the browser Storage Manager API to request persistent
        local storage permissions, protecting your offline tasks and daily shadow backups against automatic browser eviction.
      </div>
    </Fragment>
  </Content>

  <!-- Technology -->
  <Content
    tagline="Technology Stack"
    title="Built on Modern Open Standards"
    items={[
      {
        title: 'React 19 Engine',
        description: 'Blazing fast, reactive rendering with zero lag across desktop and mobile devices.',
      },
      {
        title: 'Client-Side Web Crypto API',
        description: 'Standardized browser cryptography providing hardware-accelerated AES-256-GCM encryption.',
      },
      {
        title: 'Cloudflare D1 Serverless Edge',
        description: 'Distributed global edge database delivering sub-500ms encrypted multi-device synchronization.',
      },
      {
        title: 'Web Speech API',
        description:
          'Native browser speech recognition with real-time spoken punctuation and live voice editing commands.',
      },
    ]}
    image={{
      src: '~/assets/images/about-technology.svg',
      alt: 'Modern Web Standards and Security Stack',
      width: 800,
      height: 680,
    }}
  >
    <Fragment slot="content">
      <p class="text-lg mb-6">
        By leveraging modern browser capabilities, service workers, and serverless edge databases, 123 ToDo delivers
        enterprise-grade performance and security while remaining lightweight, fast, and completely free.
      </p>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50/50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Call to Action -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Start Using 123 ToDo',
        href: 'https://app.123todo.com',
        icon: 'tabler:rocket',
      },
    ]}
  >
    <Fragment slot="title"> Ready to take control of your tasks? </Fragment>

    <Fragment slot="subtitle">
      Join users who've chosen privacy, simplicity, and zero data lock-in. No signup required.
    </Fragment>
  </CallToAction>
</Layout>
