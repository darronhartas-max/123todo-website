---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'About 123 To Do — The Free, Feature-Packed Task & Voice Notes Engine',
  description:
    'Discover why 123 To Do is the ultimate free alternative to paid task managers. Packed with pro features, zero-knowledge AES-256 encryption, dual-skin operating modes, and 100% open source under the MIT License.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Section with Authentic Photographic Workspace Image -->
  <Hero
    image={{
      src: '~/assets/images/about-hero-photo.jpg',
      alt: '123 To Do calm, focused workspace on laptop and phone in natural morning light',
      width: 1024,
      height: 576,
    }}
    actions={[
      {
        variant: 'primary',
        text: 'Launch 123 To Do Free',
        href: 'https://app.123todo.com',
        target: '_blank',
      },
      {
        text: 'Why Switch to 123 To Do?',
        href: '#why-switch',
      },
    ]}
  >
    <Fragment slot="title">
      The World’s Most Powerful<br class="hidden sm:inline" />
      <span class="text-accent dark:text-white highlight inline-block">Free Task Manager</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="text-lg text-balance block max-w-3xl mx-auto">
        Engineered for deep-work focus, trade contractors, and privacy purists. A feature-loaded powerhouse that proudly
        rivals and outperforms subscription tools like Todoist, TickTick, and Things 3—<strong
          class="text-purple-600 dark:text-purple-400">100% free</strong
        >, zero ads, and client-side encrypted.
      </span>
    </Fragment>
  </Hero>

  <!-- PUSHED TO TOP: The Free Advantage & Why People Should Switch -->
  <section
    id="why-switch"
    class="scroll-mt-20 py-12 md:py-16 bg-slate-50 dark:bg-slate-900/60 border-y border-slate-200 dark:border-slate-800"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-10 md:mb-14">
        <p class="text-xs sm:text-sm font-bold tracking-wider uppercase text-blue-600 dark:text-blue-400">
          The Competitive Advantage
        </p>
        <h2
          class="text-3xl md:text-5xl font-bold font-heading tracking-tight text-heading dark:text-white mt-2 mb-4 text-balance"
        >
          Why Pay $48/Year for Features We Give You Free?
        </h2>
        <p class="text-lg text-muted dark:text-slate-300 max-w-2xl mx-auto text-balance">
          Major productivity apps put basic capabilities behind paywalls. 123 To Do delivers world-leading feature depth
          with zero subscription traps.
        </p>
      </div>

      <!-- 5 Core Pillars of Superiority -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Benefit 1: Zero Paywalls -->
        <div
          class="bg-white dark:bg-slate-800 p-6 md:p-8 rounded-2xl border border-slate-200 dark:border-slate-700/80 shadow-sm flex flex-col hover:shadow-md transition"
        >
          <div
            class="w-12 h-12 rounded-xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-5 font-bold"
          >
            <Icon name="tabler:currency-dollar-off" class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Truly 100% Free</h3>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed flex-1">
            Photo attachments, reminders, recurring routines, subtask checklists, and unlimited projects are 100% free.
            No 14-day trials, no tier limits, and no credit card prompts.
          </p>
          <div
            class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-700/60 text-xs font-semibold text-emerald-600 dark:text-emerald-400"
          >
            ✓ Saves you $36–$72 every year
          </div>
        </div>

        <!-- Benefit: Real-Time Multi-Device Sync -->
        <div
          class="bg-white dark:bg-slate-800 p-6 md:p-8 rounded-2xl border border-slate-200 dark:border-slate-700/80 shadow-sm flex flex-col hover:shadow-md transition"
        >
          <div
            class="w-12 h-12 rounded-xl bg-sky-100 dark:bg-sky-950/60 text-sky-600 dark:text-sky-400 flex items-center justify-center mb-5 font-bold"
          >
            <Icon name="tabler:devices" class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Instant Multi-Device Sync</h3>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed flex-1">
            Pair iPhone, Android, Mac, Windows, and Linux in seconds with simple 6-digit codes. All changes sync in real
            time with zero-knowledge AES-256 encryption.
          </p>
          <div
            class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-700/60 text-xs font-semibold text-sky-600 dark:text-sky-400"
          >
            ✓ Seamless cross-device continuity
          </div>
        </div>

        <!-- Benefit 2: Dual-Skin OS -->
        <div
          class="bg-white dark:bg-slate-800 p-6 md:p-8 rounded-2xl border border-slate-200 dark:border-slate-700/80 shadow-sm flex flex-col hover:shadow-md transition"
        >
          <div
            class="w-12 h-12 rounded-xl bg-blue-100 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center mb-5 font-bold"
          >
            <Icon name="tabler:transform" class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Dual-Skin Versatility</h3>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed flex-1">
            Switch in 1 tap between a structured <strong>Task Manager</strong> (P1–P4 matrix, checklists, Kanban) and a simple
            <strong>Voice Notes</strong> skin with large text and hands-free speech dictation.
          </p>
          <div
            class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-700/60 text-xs font-semibold text-blue-600 dark:text-blue-400"
          >
            ✓ One unified database, two skins
          </div>
        </div>

        <!-- Benefit 3: True Zero-Knowledge Privacy -->
        <div
          class="bg-white dark:bg-slate-800 p-6 md:p-8 rounded-2xl border border-slate-200 dark:border-slate-700/80 shadow-sm flex flex-col hover:shadow-md transition"
        >
          <div
            class="w-12 h-12 rounded-xl bg-purple-100 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 flex items-center justify-center mb-5 font-bold"
          >
            <Icon name="tabler:shield-lock" class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Zero-Knowledge E2EE</h3>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed flex-1">
            Unlike commercial clouds that store plaintext tasks on their servers, all your data is encrypted client-side
            with military-grade <strong>AES-256-GCM</strong>. Neither we nor cloud providers can read your notes.
          </p>
          <div
            class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-700/60 text-xs font-semibold text-purple-600 dark:text-purple-400"
          >
            ✓ Mathematically unreadable to servers
          </div>
        </div>

        <!-- Benefit 4: Universal 1-Click Migration -->
        <div
          class="bg-white dark:bg-slate-800 p-6 md:p-8 rounded-2xl border border-slate-200 dark:border-slate-700/80 shadow-sm flex flex-col hover:shadow-md transition"
        >
          <div
            class="w-12 h-12 rounded-xl bg-amber-100 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center mb-5 font-bold"
          >
            <Icon name="tabler:file-import" class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">10-Second Migration</h3>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed flex-1">
            Import your entire active setup from Todoist, TickTick, Google Keep, Google Tasks, or Microsoft To Do in
            seconds. Priorities, checklists, and projects map over seamlessly.
          </p>
          <div
            class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-700/60 text-xs font-semibold text-amber-600 dark:text-amber-400"
          >
            ✓ Zero data loss or lock-in
          </div>
        </div>
      </div>

      <!-- Quick Comparison Callout -->
      <div
        class="mt-10 p-6 bg-white dark:bg-slate-800 rounded-2xl border border-blue-200 dark:border-slate-700 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left"
      >
        <div class="flex items-center gap-4">
          <div
            class="w-12 h-12 rounded-xl bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center flex-shrink-0"
          >
            <Icon name="tabler:award" class="w-7 h-7" />
          </div>
          <div>
            <h4 class="text-lg font-bold text-slate-900 dark:text-white">
              World-Class Feature Parity Without the Monthly Bill
            </h4>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300">
              Clock Face scheduling with Apple &amp; Google Calendar (.ics) export, 3-photo attachments, 10-tier
              achievements, 24-hour shadow backups, and MIT Open Source auditability.
            </p>
          </div>
        </div>
        <a
          href="https://app.123todo.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-bold bg-blue-600 hover:bg-blue-700 text-white shadow-md hover:scale-105 transition-all whitespace-nowrap flex-shrink-0 cursor-pointer"
        >
          <span>Try 123 To Do Free</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Our Story: Rejecting Software Bloat -->
  <Content
    tagline="Our Philosophy"
    title="Why We Built 123 To Do"
    items={[]}
    image={{
      src: '~/assets/images/new_grab.jpg',
      alt: '123 To Do Priority Matrix and Custom Project Workspace UI Grab',
    }}
  >
    <Fragment slot="content">
      <p class="text-lg mb-6 leading-relaxed">
        In a digital landscape dominated by venture-backed apps that lock essential productivity features behind
        aggressive $5/month paywalls, track your personal habits, and clutter your day with unnecessary notifications,
        we asked a fundamental question:
      </p>

      <div class="p-5 mb-6 rounded-xl bg-blue-50/70 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-900/50">
        <p class="text-lg font-semibold text-primary dark:text-blue-300 italic">
          "Why can't task management be lightning-fast, packed with power features, completely private, and 100% free?"
        </p>
      </div>

      <p class="text-lg mb-6 leading-relaxed">
        123 To Do was engineered to eliminate productivity friction. We discarded recurring subscriptions, database
        setup complexity, and invasive tracking scripts to build an application grounded in core commitments:
      </p>

      <ul class="text-base sm:text-lg mb-6 space-y-3.5 list-none">
        <li class="flex items-start gap-2.5">
          <span class="text-emerald-500 font-bold text-xl">✓</span>
          <span
            ><strong class="font-semibold text-slate-900 dark:text-white">Pro-Grade Features Included Free:</strong> Photo
            attachments, subtask checklists, calendar export, and custom project boards without forced paywalls.</span
          >
        </li>
        <li class="flex items-start gap-2.5">
          <span class="text-emerald-500 font-bold text-xl">✓</span>
          <span
            ><strong class="font-semibold text-slate-900 dark:text-white">100% Client-Side Private:</strong> Encrypted on
            your device via AES-256-GCM before multi-device synchronization.</span
          >
        </li>
        <li class="flex items-start gap-2.5">
          <span class="text-emerald-500 font-bold text-xl">✓</span>
          <span
            ><strong class="font-semibold text-slate-900 dark:text-white">Lightning Fast &amp; Offline-First:</strong> Progressive
            Web App (PWA) engineering launches in milliseconds even when completely disconnected.</span
          >
        </li>
        <li class="flex items-start gap-2.5">
          <span class="text-emerald-500 font-bold text-xl">✓</span>
          <span
            ><strong class="font-semibold text-slate-900 dark:text-white">100% Open Source (MIT):</strong> Auditable, transparent,
            and community-driven. Verify our security on <a
              href="https://github.com/darronhartas-max/123todo-react"
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary dark:text-blue-400 font-semibold underline hover:text-blue-600">GitHub</a
            >.</span
          >
        </li>
      </ul>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Dual Skins: Desk Focus vs. Job-Site Field Notes -->
  <Content
    isReversed
    tagline="Field & Desk Versatility"
    title="Dual Skins & Hands-Free Voice Dictation"
    items={[]}
    image={{
      src: '~/assets/images/Notes_grab.png',
      alt: '123 To Do Simple Voice Notes Mode and Hands-Free Dictation Canvas UI Grab',
    }}
  >
    <Fragment slot="content">
      <p class="text-lg mb-6 leading-relaxed">
        Whether you are at your desk planning deliverables or walking a job site in the field, 123 To Do adapts to your
        environment through our innovative <strong>Dual Skin Operating System</strong>:
      </p>

      <div class="space-y-4 mb-6 text-slate-700 dark:text-slate-300">
        <div class="p-5 bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700">
          <h4 class="font-bold text-primary dark:text-blue-400 mb-1.5 text-lg flex items-center gap-2">
            <span>📋 Task Manager Mode</span>
          </h4>
          <p class="text-sm leading-relaxed">
            Your structured command center featuring the high-clarity P1–P4 priority matrix (Must Do, Should Do, Could
            Do, On Hold), custom color-coded projects, drag-and-drop reordering, interactive clock face time scheduling,
            subtask checklists, and desktop Kanban columns.
          </p>
        </div>

        <div class="p-5 bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700">
          <h4 class="font-bold text-amber-600 dark:text-amber-400 mb-1.5 text-lg flex items-center gap-2">
            <span>🎙️ Simple Voice Notes Mode</span>
          </h4>
          <p class="text-sm leading-relaxed">
            High-contrast, large-text dictation canvas designed for builders, contractors, trade specialists, and rapid
            on-the-go thought capture. Tap the microphone to dictate continuously with spoken punctuation recognition (<em
              >"full stop"</em
            >, <em>"comma"</em>, <em>"new line"</em>) and live voice editing commands.
          </p>
        </div>
      </div>

      <p class="text-sm text-slate-500 dark:text-slate-400">
        💡 <em
          >Both modes share the exact same underlying encrypted dataset. Switch back and forth in one tap at any time.</em
        >
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50/50 dark:bg-slate-900/40"></div>
    </Fragment>
  </Content>

  <!-- Zero-Knowledge Security & Cloud Sync -->
  <Content
    tagline="Privacy & Cryptography"
    title="Zero-Knowledge Security & Encrypted Sync"
    items={[]}
    image={{
      src: '~/assets/images/blog-zero-knowledge.jpg',
      alt: '123 To Do Zero-Knowledge Encryption Shield and Encrypted Device Pairing',
    }}
  >
    <Fragment slot="content">
      <p class="text-lg mb-6 leading-relaxed">
        We believe privacy is an absolute human right. Unlike corporate cloud services that store plaintext tasks on
        their servers, 123 To Do encrypts all your data on your local device using <strong
          >AES-256-GCM client-side encryption</strong
        > before any synchronization occurs.
      </p>

      <h3 class="text-xl font-bold mb-3 text-slate-900 dark:text-white">Two Flexible Encrypted Sync Options:</h3>

      <ul class="space-y-3.5 text-base text-slate-700 dark:text-slate-300 mb-6">
        <li class="flex items-start gap-2.5">
          <Icon name="tabler:bolt" class="w-5 h-5 text-blue-500 flex-shrink-0 mt-0.5" />
          <span>
            <strong>123 To Do Cloud Sync (Default):</strong> Powered by Cloudflare D1 serverless edge database with effortless
            6-digit device pairing codes. Fast, reliable synchronization across phone, tablet, and computer.
          </span>
        </li>
        <li class="flex items-start gap-2.5">
          <Icon name="tabler:brand-google-drive" class="w-5 h-5 text-blue-500 flex-shrink-0 mt-0.5" />
          <span>
            <strong>Google Drive AppData Sync:</strong> Encrypted payloads sync directly to your personal Google account's
            hidden AppData folder, so your data stays solely within your own Google ecosystem.
          </span>
        </li>
      </ul>

      <div
        class="p-4 bg-emerald-50 dark:bg-emerald-950/40 rounded-xl border border-emerald-200 dark:border-emerald-800 text-xs sm:text-sm text-emerald-900 dark:text-emerald-200"
      >
        🛡️ <strong>Zero Server Access:</strong> Neither 123 To Do, Cloudflare, Google, nor any network interceptor possesses
        your private encryption keys. Your tasks are mathematically impossible for third parties to read.
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Universal Importer & Zero Lock-In (Data Freedom) -->
  <WidgetWrapper containerClass="max-w-6xl mx-auto py-12 md:py-16">
    <Headline
      tagline="Data Freedom"
      title="Universal Migration & Zero Lock-In Guarantee"
      subtitle="Switch away from subscription tools in seconds and maintain 100% data portability."
      classes={{
        container: 'max-w-3xl mx-auto text-center mb-12',
        title: 'text-3xl md:text-4xl font-bold tracking-tight mb-4 font-heading',
        subtitle: 'text-lg text-muted dark:text-slate-400',
      }}
    />

    <!-- Interactive Data Freedom Flow Strip -->
    <div
      class="mb-14 p-6 sm:p-8 rounded-2xl bg-gradient-to-r from-blue-500/5 via-primary/10 to-emerald-500/5 dark:from-blue-900/20 dark:via-slate-800/60 dark:to-emerald-900/20 border border-blue-200/60 dark:border-blue-800/40 shadow-sm backdrop-blur-sm"
    >
      <div class="flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
        <div class="flex items-center gap-4">
          <div
            class="w-12 h-12 rounded-xl bg-blue-100 dark:bg-blue-900/50 flex items-center justify-center text-blue-600 dark:text-blue-300 font-bold shrink-0 shadow-sm"
          >
            <Icon name="tabler:file-import" class="w-6 h-6" />
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider font-semibold text-blue-600 dark:text-blue-400">
              Step 1: Ingest
            </div>
            <div class="font-bold text-slate-900 dark:text-white">Import from Any App</div>
            <div class="text-xs text-muted dark:text-slate-400">Todoist, TickTick, Keep, MS To Do</div>
          </div>
        </div>

        <div class="hidden md:flex items-center text-slate-300 dark:text-slate-600">
          <Icon name="tabler:arrow-narrow-right" class="w-8 h-8" />
        </div>

        <div class="flex items-center gap-4">
          <div
            class="w-12 h-12 rounded-xl bg-emerald-100 dark:bg-emerald-900/50 flex items-center justify-center text-emerald-600 dark:text-emerald-300 font-bold shrink-0 shadow-sm"
          >
            <Icon name="tabler:shield-check" class="w-6 h-6" />
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider font-semibold text-emerald-600 dark:text-emerald-400">
              Step 2: Preserve
            </div>
            <div class="font-bold text-slate-900 dark:text-white">Zero Truncation Core</div>
            <div class="text-xs text-muted dark:text-slate-400">Unlimited text, AES-256 encrypted</div>
          </div>
        </div>

        <div class="hidden md:flex items-center text-slate-300 dark:text-slate-600">
          <Icon name="tabler:arrow-narrow-right" class="w-8 h-8" />
        </div>

        <div class="flex items-center gap-4">
          <div
            class="w-12 h-12 rounded-xl bg-amber-100 dark:bg-amber-900/50 flex items-center justify-center text-amber-600 dark:text-amber-300 font-bold shrink-0 shadow-sm"
          >
            <Icon name="tabler:lock-open" class="w-6 h-6" />
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider font-semibold text-amber-600 dark:text-amber-400">
              Step 3: Sovereignty
            </div>
            <div class="font-bold text-slate-900 dark:text-white">100% Data Ownership</div>
            <div class="text-xs text-muted dark:text-slate-400">1-click JSON export &amp; 24h backups</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Editorial Feature Stream (Divided Rows) -->
    <div class="space-y-10">
      <!-- Item 1: Multi-App Importer -->
      <div class="flex flex-col md:flex-row md:items-start gap-6 pb-10 border-b border-slate-200 dark:border-slate-800">
        <div class="flex items-center gap-4 md:w-1/3 shrink-0">
          <div
            class="w-12 h-12 rounded-xl bg-blue-100 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0"
          >
            <Icon name="tabler:file-import" class="w-6 h-6" />
          </div>
          <div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white">Universal Multi-App Importer</h3>
            <span
              class="inline-block mt-1 text-xs font-semibold px-2.5 py-0.5 rounded-full bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800"
              >1-Click Migration</span
            >
          </div>
        </div>
        <div class="md:w-2/3">
          <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
            Migrate from existing task managers in seconds without losing your work history. Our built-in import wizard
            automatically parses formats, re-maps priorities (P1–P4), and reconstructs full nested subtask hierarchies.
          </p>
          <div class="flex flex-wrap gap-2 pt-1">
            <span
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700"
            >
              <span class="w-2 h-2 rounded-full bg-red-500"></span> Todoist (CSV)
            </span>
            <span
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700"
            >
              <span class="w-2 h-2 rounded-full bg-amber-500"></span> TickTick (Backup CSV)
            </span>
            <span
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700"
            >
              <span class="w-2 h-2 rounded-full bg-yellow-500"></span> Google Keep (Takeout JSON)
            </span>
            <span
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700"
            >
