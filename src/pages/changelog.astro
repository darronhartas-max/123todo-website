---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import changelogData from '../data/changelog.json';

const metadata = {
  title: 'Changelog — Complete 123 To Do Release & Build History',
  description:
    'Explore the full version history and changelog of 123 To Do from v1.0.0 to present. Every feature, performance optimization, and privacy improvement documented.',
};

type ReleaseItem = { title: string; desc: string };
type ReleaseEntry = [string, ReleaseItem[]];

const entries = Object.entries(changelogData) as ReleaseEntry[];
const latestVersion = entries[0]?.[0] || '3.7.4';
const totalReleases = entries.length;

const phases = [
  {
    id: 'phase-5',
    name: 'Phase 5: Modern Era & Photo Attachments',
    range: 'v3.5.0 – Present',
    badge: 'Latest Era',
    description:
      '3-Photo attachments with WebP compression & Lightbox viewer, gamified Achievements Hub with 10-tier level progression, continuous voice dictation across natural pauses, evidentiary timestamps, and silent background PWA updating.',
    borderClass: 'border-emerald-500/30 dark:border-emerald-500/20',
    bgClass: 'from-emerald-500/5 to-transparent',
    badgeClass: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20',
    entries: entries.filter(([ver]) => {
      const [maj, min] = ver.split('.').map(Number);
      return maj === 3 && min >= 5;
    }),
  },
  {
    id: 'phase-4',
    name: 'Phase 4: Dual-Skin OS & Multi-App Migration',
    range: 'v3.0.0 – v3.4.2',
    badge: 'Dual-Skin OS',
    description:
      'Introduction of the Dual-Skin Operating System (instant 1-tap toggle between Task Mode and Simple Voice Notes), 1-click competitor migration wizard (Todoist, TickTick, Google Keep, Google Tasks, MS To Do), project Kanban columns, and multi-platform social sharing.',
    borderClass: 'border-blue-500/30 dark:border-blue-500/20',
    bgClass: 'from-blue-500/5 to-transparent',
    badgeClass: 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20',
    entries: entries.filter(([ver]) => {
      const [maj, min] = ver.split('.').map(Number);
      return maj === 3 && min < 5;
    }),
  },
  {
    id: 'phase-3',
    name: 'Phase 3: Continuous Voice Dictation & E2EE Cloud Sync',
    range: 'v2.5.0 – v2.9.0',
    badge: 'Serverless Sync',
    description:
      'First speech-to-task voice input, Cloudflare D1 Zero-Knowledge serverless sync engine, spoken punctuation recognition, 2-way sync conflict merging, anti-glare light mode tones, and anonymous privacy-preserving telemetry.',
    borderClass: 'border-purple-500/30 dark:border-purple-500/20',
    bgClass: 'from-purple-500/5 to-transparent',
    badgeClass: 'bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/20',
    entries: entries.filter(([ver]) => {
      const [maj, min] = ver.split('.').map(Number);
      return maj === 2 && min >= 5;
    }),
  },
  {
    id: 'phase-2',
    name: 'Phase 2: Desktop Kanban, Subtasks & Swipe Gestures',
    range: 'v2.0.0 – v2.4.17',
    badge: 'Sync & Gestures',
    description:
      'First Google Drive AppData zero-knowledge sync, wide-screen desktop Kanban board, checklist subtasks (↳), recurrence scheduling (daily/weekly/monthly), and customizable Todoist-style swipe gestures.',
    borderClass: 'border-amber-500/30 dark:border-amber-500/20',
    bgClass: 'from-amber-500/5 to-transparent',
    badgeClass: 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20',
    entries: entries.filter(([ver]) => {
      const [maj, min] = ver.split('.').map(Number);
      return maj === 2 && min < 5;
    }),
  },
  {
    id: 'phase-1',
    name: 'Phase 1: Foundations & Offline Core',
    range: 'v1.0.0 – v1.4.3',
    badge: 'Foundations',
    description:
      'Initial launch of the 123 To Do progressive web app with the core 1-2-3 priority matrix, custom project color tabs, Dark Mode theme, automatic 24-hour shadow backups, and offline localStorage.',
    borderClass: 'border-slate-500/30 dark:border-slate-500/20',
    bgClass: 'from-slate-500/5 to-transparent',
    badgeClass: 'bg-slate-500/10 text-slate-600 dark:text-slate-400 border-slate-500/20',
    entries: entries.filter(([ver]) => {
      const [maj] = ver.split('.').map(Number);
      return maj === 1;
    }),
  },
];
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    image={{
      src: '~/assets/images/about-hero.jpg',
      alt: '123 To Do Complete Changelog and Release History',
    }}
  >
    <Fragment slot="title">
      Release <span class="text-accent dark:text-white">Changelog</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="text-lg">
        The complete build history of 123 To Do from v1.0.0 to v{latestVersion}. Transparent, documented progress
        showing every feature, performance optimization, and privacy refinement.
      </span>
    </Fragment>
  </Hero>

  <!-- Overview Stats Bar -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 -mt-8 mb-12 relative z-10">
    <div
      class="grid grid-cols-2 md:grid-cols-4 gap-4 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-xl shadow-slate-200/50 dark:shadow-none text-center"
    >
      <div class="border-r border-slate-100 dark:border-slate-800/80 pr-4 last:border-r-0">
        <div class="text-3xl font-extrabold text-accent dark:text-white mb-1">{totalReleases}+</div>
        <div class="text-xs uppercase font-bold tracking-wider text-slate-500 dark:text-slate-400">Total Releases</div>
      </div>
      <div class="border-r border-slate-100 dark:border-slate-800/80 pr-4 last:border-r-0">
        <div class="text-3xl font-extrabold text-emerald-500 mb-1">v{latestVersion}</div>
        <div class="text-xs uppercase font-bold tracking-wider text-slate-500 dark:text-slate-400">Current Version</div>
      </div>
      <div class="border-r border-slate-100 dark:border-slate-800/80 pr-4 last:border-r-0">
        <div class="text-3xl font-extrabold text-blue-500 mb-1">100%</div>
        <div class="text-xs uppercase font-bold tracking-wider text-slate-500 dark:text-slate-400">Free & Private</div>
      </div>
      <div>
        <div class="text-3xl font-extrabold text-purple-500 mb-1">Zero</div>
        <div class="text-xs uppercase font-bold tracking-wider text-slate-500 dark:text-slate-400">Data Lock-In</div>
      </div>
    </div>
  </section>

  <!-- Quick Navigation Pills -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 mb-16">
    <div class="flex items-center justify-center gap-2 sm:gap-3 flex-wrap">
      <span class="text-xs uppercase font-bold tracking-wider text-slate-400 mr-2">Jump to Era:</span>
      {
        phases.map((phase) => (
          <a
            href={`#${phase.id}`}
            class="px-3 py-1.5 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-800 hover:bg-accent hover:text-white dark:hover:bg-accent transition duration-200 border border-slate-200 dark:border-slate-700"
          >
            {phase.range}
          </a>
        ))
      }
    </div>
  </section>

  <!-- Release Phases Timeline -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-20">
    <div class="space-y-16">
      {
        phases.map((phase) => (
          <div id={phase.id} class="scroll-mt-24">
            {/* Phase Header Banner */}
            <div
              class={`p-6 sm:p-8 rounded-2xl border bg-gradient-to-br ${phase.borderClass} ${phase.bgClass} mb-8 shadow-sm`}
            >
              <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
                <span
                  class={`text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full border ${phase.badgeClass}`}
                >
                  {phase.badge}
                </span>
                <span class="text-sm font-mono font-bold text-slate-500 dark:text-slate-400">{phase.range}</span>
              </div>
              <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mb-2">{phase.name}</h2>
              <p class="text-slate-600 dark:text-slate-300 text-base leading-relaxed">{phase.description}</p>
            </div>

            {/* Version Cards Container */}
            <div class="space-y-6">
              {phase.entries.map(([ver, items]) => {
                const isLatest = ver === latestVersion;
                return (
                  <div
                    class={`p-6 rounded-xl border transition duration-200 ${isLatest ? 'bg-emerald-500/[0.03] border-emerald-500/40 shadow-lg shadow-emerald-500/5' : 'bg-white dark:bg-slate-900/60 border-slate-200 dark:border-slate-800/80 hover:border-slate-300 dark:hover:border-slate-700'}`}
                  >
                    <div class="flex items-center justify-between flex-wrap gap-3 mb-4 pb-3 border-b border-slate-100 dark:border-slate-800">
                      <div class="flex items-center gap-3">
                        <span class="text-lg font-mono font-extrabold text-slate-900 dark:text-white">v{ver}</span>
                        {isLatest && (
                          <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-emerald-500 text-white shadow-sm shadow-emerald-500/20">
                            Current Live
                          </span>
                        )}
                      </div>
                      <span class="text-xs font-medium text-slate-400">
                        {items.length} update{items.length > 1 ? 's' : ''}
                      </span>
                    </div>

                    <ul class="space-y-3 list-none p-0 m-0">
                      {items.map((item) => (
                        <li class="flex items-start gap-2.5 text-sm sm:text-base leading-relaxed text-slate-700 dark:text-slate-300">
                          <span class="inline-block mt-1 w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0" />
                          <div>
                            <strong class="font-bold text-slate-900 dark:text-white">{item.title}</strong>{' '}
                            <span>{item.desc}</span>
                          </div>
                        </li>
                      ))}
                    </ul>
                  </div>
                );
              })}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Bottom CTA -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Launch 123 To Do Now',
        href: 'https://app.123todo.com',
        target: '_blank',
      },
      {
        text: 'Read User Guide',
        href: '/guide',
      },
    ]}
  >
    <Fragment slot="title">
      Experience Continuous Innovation on <span class="text-accent dark:text-white">123 To Do</span>
    </Fragment>

    <Fragment slot="subtitle">
      No subscriptions, no account barriers, and zero trackers. Fast, private productivity that updates quietly in the
      background.
    </Fragment>
  </CallToAction>
</Layout>
