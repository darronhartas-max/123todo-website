---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'User Guide',
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    image={{
      src: '~/assets/images/frustrated.jpg',
      alt: 'Frustrated with task management - let us help',
    }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white">User Guide</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="text-lg"> Everything you need to know to master 123 ToDo </span>
    </Fragment>
  </Hero>

  <!-- Getting Started -->
  <Steps
    title="Getting Started with 123 ToDo"
    subtitle="Get up and running in under 60 seconds"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Open the App</span>',
        description:
          'Visit <a href="https://app.123todo.com" class="text-blue-600 hover:underline">app.123todo.com</a> in any modern web browser. No download or installation required to start.',
        icon: 'tabler:world',
      },
      {
        title: 'Step 2: <span class="font-medium">Add Your First Task</span>',
        description:
          'Click the "Add Task" button at the top of any priority section. Type your task (up to 250 characters by default, or set to Unlimited in Settings) and select a priority level.',
        icon: 'tabler:pencil',
      },
      {
        title: 'Step 3: <span class="font-medium">Organize and Complete</span>',
        description:
          "Drag tasks to reorder them within priorities. Click the checkbox to mark tasks complete. That's it - you're managing tasks!",
        icon: 'tabler:check',
      },
      {
        title: 'Step 4: <span class="font-medium">Install as PWA (Recommended)</span>',
        description:
          'For the best mobile experience, install 123 ToDo as a Progressive Web App. This ensures **Persistent Storage** so your tasks are never cleared by the OS.',
        icon: 'tabler:download',
      },
      {
        title: 'Step 5: <span class="font-medium">Enable Cloud Sync (Recommended)</span>',
        description:
          'Want to sync across your phone and computer? Enable **Set & Forget Cloud Sync** (or Google Drive Sync) to seamlessly sync your tasks across devices using AES-256 encrypted storage.',
        icon: 'tabler:cloud-upload',
      },
    ]}
  />

  <!-- Features Deep Dive -->
  <section class="px-4 py-16 mx-auto max-w-6xl">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Features Deep Dive</h2>
      <p class="text-xl text-gray-600 dark:text-gray-400">Master every feature of 123 ToDo</p>
    </div>

    <div class="prose prose-lg dark:prose-invert max-w-none">
      <h3>🔄 Dual Skins: Task Manager vs. Simple Voice Notes</h3>
      <p>
        123 ToDo features a 1-tap skin switcher at the top of the header bar: <code>[ 📋 Tasks | 🎙️ Voice Notes ]</code
        >.
      </p>
      <ul>
        <li>
          <strong>Task Manager Mode</strong>: Full 4-level priority matrix (P1 Must Do, P2 Should Do, P3 Could Do, P4 On
          Hold) with subtask checklists, due dates, custom project tabs, and attached notes.
        </li>
        <li>
          <strong>Simple Voice Notes Mode</strong>: Extra-large text view tailored for field work, builders,
          contractors, and on-site note taking. Allows rapid hands-free dictation into an <strong
            >Unassigned Inbox</strong
          >.
        </li>
        <li>
          <strong>Unified Note/Task Model</strong>: Every note added via the Notes view is stored directly as a <strong
            >Task</strong
          > in 123 ToDo's unified data system. The entry content forms the task item in your Unassigned Inbox, allowing you
          to easily assign projects, attach additional notes, create subtask checklists, set due dates, or assign priority
          levels (P1–P4) whenever you choose to triage your list.
        </li>
      </ul>

      <h3>🎯 Priority System & Collapsible Sections</h3>
      <p>
        123 ToDo uses a 4-level priority system to help you focus on what matters most, complete with instant
        expand/contract toggles on each priority section for an uncluttered view:
      </p>
      <ul>
        <li>
          <strong class="text-red-600">Must Do (Priority 1)</strong> - Critical tasks that must be completed today. These
          appear in red.
        </li>
        <li>
          <strong class="text-orange-600">Should Do (Priority 2)</strong> - Important tasks that should be done soon. These
          appear in orange.
        </li>
        <li>
          <strong class="text-gray-600">Could Do (Priority 3)</strong> - Nice-to-have tasks with no urgent deadline. These
          appear in gray.
        </li>
        <li>
          <strong class="text-purple-600">On Hold (Priority 4)</strong> - Tasks that are paused or waiting on something else.
          These appear in purple.
        </li>
      </ul>
      <p class="text-sm italic text-gray-600 dark:text-gray-400 mt-2">
        💡 <strong>Pro-Tip:</strong> Click the chevron icon next to any priority section title to collapse sections you aren't
        currently working on. Your preferred collapse state is saved automatically.
      </p>

      <h3>✏️ Adding and Editing Tasks</h3>
      <p><strong>To add a new task:</strong></p>
      <ol>
        <li>Click the <strong>Add Task</strong> button in the top header or at the top of your priority lists</li>
        <li>
          Type your task title (up to 250 characters by default, or set to <strong>Unlimited</strong> in Settings)
        </li>
        <li>Optionally add notes, due dates, subtasks, or assign a project category</li>
        <li>Select the priority level using the colored buttons (🔴 Must Do, 🟡 Should Do, ⚪ Could Do, 🟣 On Hold)</li>
        <li>Click <strong>Add Task</strong> (or press <code>Enter</code>) to save</li>
      </ol>

      <p><strong>To edit an existing task:</strong></p>
      <ol>
        <li>
          Click the pencil icon next to any task (or click directly on the task text) to open the <strong
            >Edit Modal</strong
          >
        </li>
        <li>Modify the title, attached notes, priority level, project category, or checklist subtasks</li>
        <li>Click <strong>Update Task</strong> (or press <code>Enter</code>) to save your changes</li>
      </ol>

      <!-- Task Length Limits & Unlimited Mode Guide Card -->
      <div class="my-6 p-6 bg-slate-50 dark:bg-slate-800/70 rounded-2xl border border-slate-200 dark:border-slate-700">
        <h4 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2 mb-2 mt-0">
          <span>📏 Task Description Character Limit &amp; Unlimited Mode</span>
        </h4>
        <p class="text-sm text-slate-600 dark:text-slate-300 mb-4">
          By default, 123 ToDo uses a <strong>250-character limit</strong> for task titles to encourage concise, punchy to-dos
          that keep your daily dashboard uncluttered and scannable at a glance. However, if you need more room, you can easily
          customize or remove this limit entirely:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
          <div
            class="p-4 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 flex flex-col"
          >
            <p class="font-bold text-slate-900 dark:text-white mb-1.5 flex items-center gap-1.5">
              <span>⚡</span>
              <span>Increasing to Unlimited Length:</span>
            </p>
            <p class="leading-relaxed flex-1">
              Need to paste extensive specifications, client requirements, or longer task instructions? Simply open <strong
                >Settings ⚙️ ➔ Appearance &amp; General Preferences ➔ Task Description Character Limit</strong
              > and choose <strong>Unlimited</strong>. This completely removes the character ceiling!
            </p>
          </div>
          <div
            class="p-4 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 flex flex-col"
          >
            <p class="font-bold text-slate-900 dark:text-white mb-1.5 flex items-center gap-1.5">
              <span>📝</span>
              <span>Unlimited Task Notes &amp; Details:</span>
            </p>
            <p class="leading-relaxed flex-1">
              Remember that the secondary <strong>Task Notes</strong> field is always <strong>100% Unlimited</strong> with
              zero length restrictions by design. You can attach paragraphs of context, addresses, meeting transcripts, links,
              and photos without affecting your task headline.
            </p>
          </div>
        </div>
      </div>

      <!-- Actionable Phone Numbers & Email Links -->
      <div
        class="my-6 p-6 bg-blue-50/70 dark:bg-blue-950/30 rounded-2xl border border-blue-200 dark:border-blue-900/50"
      >
        <h4 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2 mb-2 mt-0">
          <span>📞 Actionable Phone Numbers, Email Links &amp; Email Service Picker</span>
        </h4>
        <p class="text-sm text-slate-600 dark:text-slate-300 mb-4">
          Tasks and notes often contain contact information. 123 ToDo automatically detects telephone numbers and email
          addresses, transforming them into instant clickable actions across desktop and mobile:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
          <div class="p-4 bg-white dark:bg-slate-900 rounded-xl border border-blue-200 dark:border-slate-700">
            <p class="font-bold text-slate-900 dark:text-white mb-1 flex items-center gap-1.5">
              <span>📱</span>
              <span>One-Tap Telephone Dialing:</span>
            </p>
            <p class="leading-relaxed">
              Any valid UK or international phone number in a task or note becomes a clickable <code>tel:</code> link. On
              mobile devices, tapping it opens your phone dialer instantly. On desktop, it triggers FaceTime or your system
              calling app.
            </p>
          </div>
          <div class="p-4 bg-white dark:bg-slate-900 rounded-xl border border-blue-200 dark:border-slate-700">
            <p class="font-bold text-slate-900 dark:text-white mb-1 flex items-center gap-1.5">
              <span>✉️</span>
              <span>Preferred Email Service Picker:</span>
            </p>
            <p class="leading-relaxed">
              Clicking an email address prompts you once to pick your favorite service: <strong>Default Mail App</strong
              > (Apple Mail, Outlook Desktop, Thunderbird), <strong>Gmail Web</strong>, <strong
                >Outlook / Microsoft 365 Web</strong
              >, or <strong>Yahoo Mail</strong>. 123 ToDo remembers your choice so future clicks open compose directly.
              You can modify or reset your preference anytime in <strong>Settings ⚙️ ➔ Preferred Email Service</strong>.
            </p>
          </div>
        </div>
      </div>

      <div
        class="my-8 p-6 bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-slate-800/80 dark:to-slate-800/50 rounded-2xl stroke-blue-200 dark:stroke-slate-700 border border-blue-100 dark:border-slate-700"
      >
        <h3 class="text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2 mb-3 mt-0">
          <span>🎙️ Voice-to-Text & Spoken Commands Guide</span>
        </h3>
        <p class="text-slate-600 dark:text-slate-300 text-base mb-4">
          Capture tasks 5x faster using continuous voice dictation with automatic spoken punctuation, live editing, and
          hands-free task submission!
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
          <!-- Spoken Punctuation -->
          <div class="bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200 dark:border-slate-700">
            <h4
              class="font-bold text-slate-900 dark:text-white text-sm uppercase tracking-wide mb-2 flex items-center gap-1.5"
            >
              <span>✍️ Spoken Punctuation</span>
            </h4>
            <ul class="text-xs text-slate-600 dark:text-slate-300 space-y-1">
              <li>
                <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-blue-600 dark:text-blue-400"
                  >full stop</code
                > / <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-blue-600 dark:text-blue-400"
                  >period</code
                > / <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-blue-600 dark:text-blue-400"
                  >dot</code
                > ➔ <strong class="text-slate-900 dark:text-white">.</strong>
              </li>
              <li>
                <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-blue-600 dark:text-blue-400"
                  >comma</code
                > ➔ <strong class="text-slate-900 dark:text-white">,</strong>
              </li>
              <li>
                <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-blue-600 dark:text-blue-400"
                  >question mark</code
                > ➔ <strong class="text-slate-900 dark:text-white">?</strong>
              </li>
              <li>
                <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-blue-600 dark:text-blue-400"
                  >exclamation mark</code
                > ➔ <strong class="text-slate-900 dark:text-white">!</strong>
              </li>
              <li>
                <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-blue-600 dark:text-blue-400"
                  >colon</code
                > / <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-blue-600 dark:text-blue-400"
                  >semi colon</code
                > ➔ <strong class="text-slate-900 dark:text-white">:</strong> / <strong
                  class="text-slate-900 dark:text-white">;</strong
                >
              </li>
              <li>
                <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-blue-600 dark:text-blue-400"
                  >new line</code
                > ➔ Inserts line break (auto-capitalizes next sentence)
              </li>
            </ul>
          </div>

          <!-- Spoken Deletions & Commands -->
          <div class="bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200 dark:border-slate-700">
            <h4
              class="font-bold text-slate-900 dark:text-white text-sm uppercase tracking-wide mb-2 flex items-center gap-1.5"
            >
              <span>✂️ Spoken Edits & Auto-Submit</span>
            </h4>
            <ul class="text-xs text-slate-600 dark:text-slate-300 space-y-1">
              <li>
                <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-amber-600 dark:text-amber-400"
                  >delete last word</code
                > / <code
                  class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-amber-600 dark:text-amber-400"
                  >scratch that</code
                > ➔ Remakes last phrase
              </li>
              <li>
                <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-amber-600 dark:text-amber-400"
                  >delete last N words</code
                > ➔ Deletes specified word count
              </li>
              <li>
                <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-red-600 dark:text-red-400"
                  >clear all</code
                > ➔ Resets entire transcript input
              </li>
              <li>
                <code
                  class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-emerald-600 dark:text-emerald-400"
                  >add task</code
                > / <code
                  class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-emerald-600 dark:text-emerald-400"
                  >add note</code
                > / <code
                  class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-emerald-600 dark:text-emerald-400"
                  >save task</code
                > ➔ Saves task or note hands-free!
              </li>
            </ul>
          </div>
        </div>

        <p class="text-xs text-slate-500 dark:text-slate-400 italic">
          💡 <strong>Live Auto-Scroll Viewport:</strong> As you dictate long task titles or notes, the canvas automatically
          expands and scrolls down so your latest spoken words remain 100% visible at the bottom.
        </p>
      </div>

      <div
        class="my-8 p-6 bg-gradient-to-br from-sky-50 to-blue-50 dark:from-slate-800/80 dark:to-slate-800/50 rounded-2xl stroke-blue-200 dark:stroke-slate-700 border border-sky-100 dark:border-slate-700"
      >
        <h3 class="text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2 mb-3 mt-0">
          <span>📸 Photo &amp; Screenshot Attachments in Notes</span>
        </h3>
        <p class="text-slate-600 dark:text-slate-300 text-base mb-4">
          Attach up to 3 photos per note or task! Engineered for rapid field work on mobile and instant screenshot
          pasting on desktop with 100% free offline storage.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
          <div class="bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200 dark:border-slate-700">
            <h4
              class="font-bold text-slate-900 dark:text-white text-sm uppercase tracking-wide mb-2 flex items-center gap-1.5"
            >
              <span>📱 On Mobile (iPhone &amp; Android)</span>
            </h4>
            <ul class="text-xs text-slate-600 dark:text-slate-300 space-y-1.5">
              <li>
                <strong>Camera Button:</strong> Launches your device camera directly to snap on-site conditions, receipts,
                or job status.
              </li>
              <li>
                <strong>Attach Button:</strong> Browse and upload existing photos from your camera roll or photo library.
              </li>
              <li>
                <strong>Instant Thumbnails:</strong> View lightweight preview thumbnails with file sizes and 1-tap delete
                controls.
              </li>
            </ul>
          </div>

          <div class="bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200 dark:border-slate-700">
            <h4
              class="font-bold text-slate-900 dark:text-white text-sm uppercase tracking-wide mb-2 flex items-center gap-1.5"
            >
              <span>💻 On Desktop (Mac, Windows, Linux)</span>
            </h4>
            <ul class="text-xs text-slate-600 dark:text-slate-300 space-y-1.5">
              <li>
                <strong>Direct Clipboard Paste:</strong> Grab a screenshot (<code
                  class="bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded text-blue-600">Cmd+Shift+4</code
                > or <code class="bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded text-blue-600">Win+Shift+S</code>)
                and press <strong class="text-blue-600 dark:text-blue-400">Cmd+V / Ctrl+V</strong> inside the note!
              </li>
              <li>
                <strong>Drag-and-Drop:</strong> Drag image files directly from your file manager into the note area.
              </li>
              <li>
                <strong>Full-Screen Lightbox:</strong> Click any thumbnail to open the Lightbox with 2.0x zoom and instant
                download.
              </li>
            </ul>
          </div>
        </div>

        <p class="text-xs text-slate-500 dark:text-slate-400 italic">
          💡 <strong>Smart WebP Compression &amp; IndexedDB:</strong> Photos are automatically compressed client-side (max
          2048px, ~150KB–250KB) to preserve razor-sharp receipt text while keeping storage lean and offline-ready in IndexedDB.
        </p>
      </div>

      <h3>✅ Completing Tasks</h3>
      <p>
        Click the checkbox next to any task to mark it complete. Completed tasks move to the Archive section at the
        bottom of the page. You can restore archived tasks anytime by clicking the restore icon.
      </p>

      <h3>↕️ Reordering & Moving Tasks</h3>
      <p>Tasks can be sorted and moved using intuitive drag and drop mechanics:</p>
      <ul>
        <li>
          <strong>Sort within a list</strong>: Click and hold any task, then drag it up or down in the same section to
          reorder it.
        </li>
        <li>
          <strong>Move across priorities</strong>: Drag a task to a different priority section. Dropping it on another
          task will assign it to that priority and position it there.
        </li>
        <li>
          <strong>Drop at the very top</strong>: Drag a task directly onto the section header or empty area of a
          priority list to place it at the absolute top (a dashed border will highlight the active drop zone).
        </li>
      </ul>

      <h3>🗑️ Deleting Tasks</h3>
      <p>
        To permanently delete a task, click the trash icon. You'll see a confirmation prompt.
        <strong>Deleted tasks cannot be recovered.</strong>
      </p>

      <h3>📦 Archive System</h3>
      <p>
        Completed tasks are automatically moved to the Archive section at the bottom of the page. The archive shows:
      </p>
      <ul>
        <li>All completed tasks with their original priority colors</li>
        <li>Completion timestamps</li>
        <li>Options to restore (move back to active) or permanently delete</li>
      </ul>

      <h3>📋 Subtasks & Checklists</h3>
      <p>For large or complex tasks, you can break them down into smaller, manageable steps:</p>
      <ul>
        <li>
          <strong>Create Checklists</strong>: Inside the Add Task or Edit Task interface, click the <em>📋 Subtasks</em>
          button to create a checklist of sub-steps.
        </li>
        <li>
          <strong>Check Off Steps in the Edit Modal</strong>: To keep your dashboard clean and uncluttered, individual
          subtask steps are shown only inside the <strong>Edit Modal</strong>. Simply tap/click a task to open it and
          check off steps, add new ones, or remove completed items.
        </li>
        <li>
          <strong>Progress Bar Tracking</strong>: Task cards display a visual progress bar and percentage showing how
          close the main task is to completion (e.g., <code>Steps: 1/3 (33%)</code>).
        </li>
        <li>
          <strong>Anti-Procrastination Nudges</strong>: If you defer/reschedule an active task to the future more than
          twice, the edit modal will gently alert you and suggest breaking it down into subtasks.
        </li>
      </ul>

      <h3>📅 Scheduled & Recurring Tasks</h3>
      <p>Manage upcoming work and routines without cluttering your daily view:</p>
      <ul>
        <li>
          <strong>Specific Scheduling</strong>: Set a future start date (e.g. next Tuesday) on any task. The task will
          hide automatically in the <strong>Scheduled &amp; Recurring</strong> drawer until that date arrives.
        </li>
        <li>
          <strong>Scheduled Tasks Drawer</strong>: Located between On Hold and Archive at the bottom, this collapsible
          drawer keeps future tasks organised and out of sight. Full scheduling details (date, recurrence pattern) are
          shown here — keeping your main active lists clean and uncluttered.
        </li>
        <li>
          <strong>Detailed Recurrence Rules</strong>: Set tasks to repeat at custom intervals — such as every 3 days,
          every 2 weeks, every Monday, or every 3 months. You can combine a repeat interval with specific weekdays for
          patterns like &ldquo;every Monday and Thursday&rdquo;.
        </li>
        <li>
          <strong>Instant Recurrence Setup — No Start Date Required</strong>: Simply check
          <em>🔁 Repeat this task</em> and the start date automatically defaults to today. If you select specific weekdays
          (e.g. every Monday), the start date instantly snaps to the next upcoming Monday — no manual calendar hunting needed.
        </li>
        <li>
          <strong>Defer a Task</strong>: Use the calendar icon on any scheduled task card to quickly reschedule it to a
          new date. The task returns to the Scheduled drawer with its updated date.
        </li>
        <li>
          <strong>Automatic Cycle Rollover</strong>: When you complete a recurring task, the current instance is
          archived, and the next occurrence is automatically generated in the Scheduled drawer, resetting its subtasks
          checklist for the new cycle.
        </li>
      </ul>

      <h3>🏆 Productivity Achievements & 10-Tier Mastery Hub</h3>
      <p>
        Stay motivated with 123 ToDo's built-in gamification engine! Tap the <strong>Trophy Icon (🏆)</strong> in the top
        header to open your personal <strong>Productivity &amp; Achievements Modal</strong>:
      </p>
      <ul>
        <li>
          <strong>Productivity Points Engine</strong>: Earn points naturally as you get things done (+10 pts per task
          completed, +2 pts per checklist subtask checked, +15 pts per active streak day).
        </li>
        <li>
          <strong>10 Progressive Achievement Tiers</strong>: Advance from <em>Level 1: Focused Starter 🌱</em> to the elite,
          virtually unachievable pinnacle <em>Level 10: 123 Immortal 👑</em> (50,000+ points).
        </li>
        <li>
          <strong>Daily Focus Streaks</strong>: Build unbreakable compounding habits by maintaining an active
          consecutive daily completion streak.
        </li>
        <li>
          <strong>1-2-3 Balance Analytics</strong>: Visualise your execution balance across Must-Do (P1), Should-Do
