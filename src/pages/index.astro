---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

const metadata = {
  title: '123 ToDo - Free Task Manager, Daily To-Do List App & Voice Notes App (Best Todoist & TickTick Alternative)',
  description:
    '123 ToDo is a fast, 100% free task manager and to-do list app with voice notes, subtasks, daily streaks, zero-knowledge encryption, and 1-click migration from Todoist, TickTick, Google Keep, and Microsoft To Do.',
  ignoreTitleTemplate: true,
  openGraph: {
    images: [
      {
        url: '~/assets/images/og-social-share.jpg',
        width: 1200,
        height: 630,
        alt: '123 ToDo - Free Task Manager, To-Do List App & Private Voice Notes',
      },
    ],
    type: 'website',
  },
  twitter: {
    cardType: 'summary_large_image',
  },
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Start Organizing for Free',
        href: 'https://app.123todo.com',
        icon: 'tabler:rocket',
      },
      {
        text: 'Explore Features',
        href: '#features',
      },
    ]}
    image={{
      src: '~/assets/images/productive-man.json',
      alt: 'Person organizing daily tasks and priorities with 123 ToDo free task manager',
    }}
  >
    <Fragment slot="title">
      123 ToDo — The Free, Private <br />
      <span class="text-accent dark:text-white highlight">Task Manager &amp; To-Do List App</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="text-lg">
        The simple, stress-free way to organize your day, track your to-do lists, and clear mental clutter. <br />
        <span class="font-semibold text-accent dark:text-white"
          >Zero-Knowledge Cloud Sync across iPhone, Android, Mac &amp; PC with complete data privacy.</span
        >
        <span class="text-purple-600 dark:text-purple-400 font-bold underline decoration-2 underline-offset-4"
          >100% FREE.</span
        > The ultimate private alternative to Todoist, TickTick, Google Keep, and Microsoft To Do.
      </span>
    </Fragment>
  </Hero>

  <!-- Non-Technical Life Benefits Section -->
  <section
    class="relative bg-gradient-to-b from-blue-50/70 to-white dark:from-slate-900/60 dark:to-slate-900 not-prose py-12 md:py-16 border-y border-slate-100 dark:border-slate-800"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-10 md:mb-14">
        <p class="text-base text-accent dark:text-blue-400 font-bold tracking-wide uppercase">Why Choose 123 ToDo?</p>
        <h2 class="text-3xl md:text-5xl font-bold font-heading tracking-tight text-heading dark:text-white mt-2 mb-4">
          Turn Daily Chaos into Calm &amp; Clarity
        </h2>
        <p class="text-xl text-muted dark:text-slate-300">
          Discover how effortless organization frees your mind, eliminates daily overwhelm, and helps you reclaim
          control over your time.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
        <!-- Benefit Card 1 -->
        <div
          class="bg-white dark:bg-slate-800/90 p-6 md:p-8 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/80 hover:shadow-md transition duration-200 flex flex-col"
        >
          <div
            class="w-14 h-14 bg-red-100 dark:bg-red-950/60 rounded-xl flex items-center justify-center mb-5 text-red-600 dark:text-red-400"
          >
            <svg
              class="w-8 h-8"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z"></path>
              <path d="M12 7v5l3 3"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">De-Stress Your Mind</h3>
          <p class="text-muted dark:text-slate-300 leading-relaxed text-sm md:text-base flex-1">
            Stop keeping tasks trapped in your head. Offload to-dos instantly into organized lists so you can relax,
            focus, and enjoy your day without burnout.
          </p>
        </div>

        <!-- Benefit Card 2 -->
        <div
          class="bg-white dark:bg-slate-800/90 p-6 md:p-8 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/80 hover:shadow-md transition duration-200 flex flex-col"
        >
          <div
            class="w-14 h-14 bg-amber-100 dark:bg-amber-950/60 rounded-xl flex items-center justify-center mb-5 text-amber-600 dark:text-amber-400"
          >
            <svg
              class="w-8 h-8"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <circle cx="12" cy="12" r="6"></circle>
              <circle cx="12" cy="12" r="2"></circle>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Clear Daily 1-2-3 Priorities</h3>
          <p class="text-muted dark:text-slate-300 leading-relaxed text-sm md:text-base flex-1">
            Focus on what truly matters today using 4 simple buckets: Must Do (P1), Should Do (P2), Could Do (P3), and
            On Hold. Eliminate decision fatigue instantly.
          </p>
        </div>

        <!-- Benefit Card 3 -->
        <div
          class="bg-white dark:bg-slate-800/90 p-6 md:p-8 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/80 hover:shadow-md transition duration-200 flex flex-col"
        >
          <div
            class="w-14 h-14 bg-emerald-100 dark:bg-emerald-950/60 rounded-xl flex items-center justify-center mb-5 text-emerald-600 dark:text-emerald-400"
          >
            <svg
              class="w-8 h-8"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Reclaim Free Time</h3>
          <p class="text-muted dark:text-slate-300 leading-relaxed text-sm md:text-base flex-1">
            When your day is organized, tasks get done faster. Finish work earlier, avoid last-minute rushes, and make
            room for family, hobbies, and rest.
          </p>
        </div>

        <!-- Benefit Card 4 -->
        <div
          class="bg-white dark:bg-slate-800/90 p-6 md:p-8 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/80 hover:shadow-md transition duration-200 flex flex-col"
        >
          <div
            class="w-14 h-14 bg-purple-100 dark:bg-purple-950/60 rounded-xl flex items-center justify-center mb-5 text-purple-600 dark:text-purple-400"
          >
            <svg
              class="w-8 h-8"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">100% Free, Instant Start</h3>
          <p class="text-muted dark:text-slate-300 leading-relaxed text-sm md:text-base flex-1">
            No registration, no passwords, no email verification, and no credit card required. Open the app and be
            organized in under 60 seconds.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <Features
    id="features"
    tagline="Features & Capabilities"
    title="Everything you need in a modern task manager & to-do app"
    subtitle="Engineered for ultimate simplicity, zero-knowledge privacy, and daily productivity flow"
    classes={{
      container: '!py-6 md:!py-8',
    }}
    items={[
      {
        title: '🏆 10-Tier Milestones &amp; Gamified Productivity Points',
        description:
          'Earn points (+10 task, +2 subtask, +15 streak) and advance through 10 progressive achievement ranks from Focused Starter 🌱 to 123 Immortal 👑 with milestone badges and streak tracking.',
        icon: 'tabler:trophy',
      },
      {
        title: '🎙️ Dual Skin Modes: Task Manager vs. Simple Voice Notes',
        description:
          'Switch instantly between a structured Task Manager (P1-P4 matrix) and a Simple Voice Notes mode with extra-large text, instant hands-free dictation, and unassigned inbox triage for field contractors & trades.',
        icon: 'tabler:transform',
      },
      {
        title: '🎤 Continuous Voice Dictation &amp; Spoken Commands',
        description:
          'Dictate tasks & notes naturally on the go. Auto-formats spoken punctuation ("comma", "full stop"), auto-capitalizes sentences, and auto-saves hands-free by saying "add task" or "add note".',
        icon: 'tabler:microphone',
      },
      {
        title: '📋 Drag-and-Drop Subtasks &amp; Line Wrapping',
        description:
          'Break large goals into multi-line checklist steps. Easily reorder subtasks via drag-and-drop handles and preview progress bars directly on task cards.',
        icon: 'tabler:list-check',
      },
      {
        title: '🛡️ Zero-Knowledge E2EE Cloud Sync',
        description:
          'Keep your tasks synchronized in real-time across iPhone, iPad, Android, Mac, and Windows PC. Powered by client-side AES-256-GCM encryption with 6-digit device pairing codes.',
        icon: 'tabler:shield-lock',
      },
      {
        title: '📦 Universal 1-Click Multi-Competitor Importer',
        description:
          'Switch away from paid tools in seconds. Easily import your entire setup from Todoist (CSV), TickTick (Backup CSV), Google Keep (JSON), Google Tasks (JSON), and Microsoft To Do (CSV).',
        icon: 'tabler:file-import',
      },
      {
        title: '⚡ 100% Offline Progressive Web App (PWA)',
        description:
          'Install 123 ToDo directly to your mobile home screen or desktop. Works completely offline with 24-hour automated local shadow backups and persistent storage protection.',
        icon: 'tabler:device-mobile-check',
      },
      {
        title: '📅 Smart Scheduling &amp; Custom Recurrence Rules',
        description:
          'Schedule tasks for Today, Tomorrow, or specific weekdays. Set automated recurring tasks (e.g., every 3 days, every 2 weeks, or every Monday) that roll over automatically upon completion.',
        icon: 'tabler:calendar-repeat',
      },
      {
        title: '🎨 Color-Coded Projects &amp; Kanban Column Views',
        description:
          'Organize tasks into custom project folders with custom colors. On desktop wide screens, view your workspace grouped either by Priority tiers or Project Kanban columns.',
        icon: 'tabler:folder',
      },
      {
        title: '🔍 Space-Efficient Note Previews',
        description:
          'Tasks with attached notes display a clean single-line preview underneath the title for fast scanning without cluttering your priority lists.',
        icon: 'tabler:notes',
      },
      {
        title: '🔥 Never-Break-the-Chain Daily Streaks',
        description:
          'Build compounding daily productivity habits. Track your active daily completion streak and celebrate milestone achievements in the header.',
        icon: 'tabler:flame',
      },
      {
        title: '💸 100% Free Forever — No Subscriptions',
        description:
          'Enjoy uncapped tasks, unlimited projects, unlimited note lengths, and full sync features with zero premium paywalls, ads, or tracking.',
        icon: 'tabler:currency-dollar-off',
      },
    ]}
  />

  <!-- Competitor Comparison Section: Best Free Alternative -->
  <section class="py-12 md:py-16 bg-slate-50 dark:bg-slate-900/60 border-y border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-10 md:mb-12">
        <p class="text-base text-accent dark:text-blue-400 font-bold tracking-wide uppercase">App Comparison</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading tracking-tight text-heading dark:text-white mt-2 mb-4">
          Why 123 ToDo is the Best Alternative to Subscription Apps
        </h2>
        <p class="text-lg text-muted dark:text-slate-300">
          Looking for a free alternative to Todoist, TickTick, Google Keep, or Microsoft To Do? See how 123 ToDo
          delivers enterprise-grade features without the monthly fees.
        </p>
      </div>

      <div class="overflow-x-auto">
        <table
          class="w-full bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 text-left text-sm md:text-base"
        >
          <thead>
            <tr
              class="bg-slate-100 dark:bg-slate-900/80 border-b border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white"
            >
              <th class="p-4 font-bold">Feature</th>
              <th class="p-4 font-bold text-accent dark:text-blue-400 bg-blue-50/60 dark:bg-blue-950/40">123 ToDo</th>
              <th class="p-4 font-semibold text-slate-600 dark:text-slate-400">Todoist</th>
              <th class="p-4 font-semibold text-slate-600 dark:text-slate-400">TickTick</th>
              <th class="p-4 font-semibold text-slate-600 dark:text-slate-400">Google Keep / Tasks</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-700 text-slate-700 dark:text-slate-300">
            <tr>
              <td class="p-4 font-semibold">Cost &amp; Subscription</td>
              <td class="p-4 font-bold text-emerald-600 dark:text-emerald-400 bg-blue-50/60 dark:bg-blue-950/40"
                >100% Free Forever</td
              >
              <td class="p-4 text-slate-500">$4–$6 / month</td>
              <td class="p-4 text-slate-500">$3 / month</td>
              <td class="p-4 text-slate-500">Free (Data Tracked)</td>
            </tr>
            <tr>
              <td class="p-4 font-semibold">Data Privacy &amp; Security</td>
              <td class="p-4 font-bold text-emerald-600 dark:text-emerald-400 bg-blue-50/60 dark:bg-blue-950/40"
                >Zero-Knowledge AES-256-GCM</td
              >
              <td class="p-4 text-slate-500">Server Plaintext</td>
              <td class="p-4 text-slate-500">Server Plaintext</td>
              <td class="p-4 text-slate-500">Google Scanned</td>
            </tr>
            <tr>
              <td class="p-4 font-semibold">10-Tier Milestones &amp; Streaks</td>
              <td class="p-4 font-bold text-emerald-600 dark:text-emerald-400 bg-blue-50/60 dark:bg-blue-950/40"
                >Included Free (10 Levels)</td
              >
              <td class="p-4 text-slate-500">Karma System</td>
              <td class="p-4 text-slate-500">Achievement Score</td>
              <td class="p-4 text-slate-500">None</td>
            </tr>
            <tr>
              <td class="p-4 font-semibold">Dual Skins (Tasks + Voice Notes)</td>
              <td class="p-4 font-bold text-emerald-600 dark:text-emerald-400 bg-blue-50/60 dark:bg-blue-950/40"
                >1-Tap Instant Toggle</td
              >
              <td class="p-4 text-slate-500">Tasks Only</td>
              <td class="p-4 text-slate-500">Tasks Only</td>
              <td class="p-4 text-slate-500">Separate Apps</td>
            </tr>
            <tr>
              <td class="p-4 font-semibold">Voice Dictation &amp; Auto-Commands</td>
              <td class="p-4 font-bold text-emerald-600 dark:text-emerald-400 bg-blue-50/60 dark:bg-blue-950/40"
                >Native Hands-Free Speech</td
              >
              <td class="p-4 text-slate-500">Basic Keyboard Mic</td>
              <td class="p-4 text-slate-500">Basic Keyboard Mic</td>
              <td class="p-4 text-slate-500">Basic Audio Memo</td>
            </tr>
            <tr>
              <td class="p-4 font-semibold">Universal Competitor Migration</td>
              <td class="p-4 font-bold text-emerald-600 dark:text-emerald-400 bg-blue-50/60 dark:bg-blue-950/40"
                >1-Click 5-App Importer</td
              >
              <td class="p-4 text-slate-500">Manual / Partial</td>
              <td class="p-4 text-slate-500">Partial</td>
              <td class="p-4 text-slate-500">None</td>
            </tr>
            <tr>
              <td class="p-4 font-semibold">Offline PWA &amp; Daily Backups</td>
              <td class="p-4 font-bold text-emerald-600 dark:text-emerald-400 bg-blue-50/60 dark:bg-blue-950/40"
                >Automated 24h Shadow Backups</td
              >
              <td class="p-4 text-slate-500">Pro Tier Only</td>
              <td class="p-4 text-slate-500">Premium Only</td>
              <td class="p-4 text-slate-500">Limited</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Dual Skins Showcase -->
  <Content
    tagline="Versatile Operating System"
    title="One Free App, Two Powerful Modes"
    items={[
      {
        title: '🎙️ Simple Voice Notes Mode',
        description:
          'Extra-large text, high contrast, and rapid voice dictation controls designed for builders, contractors, and busy professionals on site. Speak measurements, materials, or updates hands-free without worrying about project tagging upfront.',
      },
      {
        title: '📋 Task Manager Mode',
        description:
          'Structured priority matrix (P1 Must Do, P2 Should Do, P3 Could Do, P4 On Hold) with subtask checklists, due dates, drag-and-drop reordering, and attached notes.',
      },
      {
        title: '🔄 Unified Cross-Platform Dataset',
        description:
          'Switch skins at will with a 1-tap header toggle. All notes and tasks live in the exact same dataset and sync automatically across all your devices via zero-knowledge Cloudflare D1 or Google Drive sync.',
      },
    ]}
    image={{
      src: '~/assets/images/Notes_grab.png',
      alt: '123 ToDo Dual Skins feature showing Task Manager Mode and Simple Voice Notes Mode',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Designed for both field work &amp; office focus
      </h3>
      <p class="text-lg">
        Whether you are on a construction site taking quick site measurements or at your desk planning your week, 123
        ToDo adapts to your workflow seamlessly.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50/50 dark:bg-slate-900/50"></div>
    </Fragment>
  </Content>

  <!-- How It Works -->
  <Content
    isReversed
    tagline="How It Works"
    title="Get organized in 3 simple steps"
    items={[
      {
        title: '1. Add Your Tasks or Voice Notes',
        description:
          'Quickly type or speak tasks with our simple interface. Attach subtask checklists or notes with zero limits.',
      },
      {
        title: '2. Set Daily 1-2-3 Priorities',
        description:
          'Organize your workload into Must Do (1), Should Do (2), and Could Do (3) buckets. Drag and drop to reorder tasks or move across categories.',
      },
      {
        title: '3. Complete, Level Up &amp; Build Streaks',
        description:
          'Check off completed tasks to earn Productivity Points, maintain your daily focus streak, and advance through 10 progressive achievement ranks!',
      },
    ]}
    image={{
      src: '~/assets/images/new_grab.jpg',
      alt: '123 ToDo app screenshot showing modern task management and priorities',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">No learning curve required</h3>
      <p class="text-lg">
        Start managing your tasks immediately. 123 ToDo is designed to be intuitive and straightforward, so you can
        focus on getting things done instead of learning complex software.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Privacy Promise -->
  <Content
    tagline="Privacy First"
    title="Your data stays 100% yours"
    items={[
      {
        title: 'Zero-Knowledge Client-Side Encryption',
        description:
          'Your tasks and notes are encrypted with AES-256-GCM directly on your device before sync. Neither we, Cloudflare, Google, nor third parties can read your private data.',
      },
      {
        title: 'No Registration Required',
        description:
          'No email, no password, no account required. Start using immediately on web, iOS, Android, Mac, or Windows without giving up personal data.',
      },
      {
        title: 'Zero Data Lock-In Guarantee',
        description:
          'Export your complete workspace data as a JSON backup anytime with 1 click, or migrate seamlessly between devices with 6-digit sync codes.',
      },
    ]}
    image={{
      src: '~/assets/images/happy-at-desk.jpg',
      alt: 'Happy person working at desk with secure, private task management app',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Built for privacy, designed for simplicity
      </h3>
      <p class="text-lg">
        In an age of constant surveillance and subscription fatigue, 123 ToDo offers a refreshing, 100% free
        alternative. We don't want your data, and we don't need it to provide you with world-class task management.
      </p>
    </Fragment>
  </Content>

  <!-- Latest Blog Posts (Displaying Latest 3 Posts) -->
  <BlogLatestPosts
    count={3}
    title="Latest from our blog"
    information={`Expert productivity guides, time management strategies, and feature updates.`}
  />

  <!-- Call to Action -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: "Get Started Now — It's Free",
        href: 'https://app.123todo.com',
        icon: 'tabler:rocket',
      },
    ]}
  >
    <Fragment slot="title"> Ready to simplify your to-do lists? </Fragment>

    <Fragment slot="subtitle">
      Start organizing your tasks today. No signup required, zero cost, completely private.
    </Fragment>
  </CallToAction>
</Layout>
