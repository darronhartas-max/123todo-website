  <script is:inline>
    const floatingCta = document.getElementById('floating-cta');
    const dismissBtn = document.getElementById('dismiss-floating-cta');
    let isDismissed = false;

    window.addEventListener('scroll', () => {
      if (isDismissed || !floatingCta) return;
      if (window.scrollY > 450) {
        floatingCta.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-6');
        floatingCta.classList.add('opacity-100', 'translate-y-0');
      } else {
        floatingCta.classList.add('opacity-0', 'pointer-events-none', 'translate-y-6');
        floatingCta.classList.remove('opacity-100', 'translate-y-0');
      }
    });

    dismissBtn?.addEventListener('click', () => {
      isDismissed = true;
      floatingCta?.classList.add('opacity-0', 'pointer-events-none', 'translate-y-6');
    });
  </script>
