---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import HeroInteractiveDemo from '~/components/interactive/HeroInteractiveDemo';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import ItemGrid from '~/components/ui/ItemGrid.astro';

const coreFeatures = [
  {
    title: 'Intuitive 1-2-3 Daily Priorities (Zero Learning Curve)',
    description:
      'Focus on what truly matters today with a simple 4-tier matrix: Must Do (P1), Should Do (P2), Could Do (P3), and On Hold. Drag and drop tasks between buckets or reorder in seconds to eliminate workday overwhelm.',
    icon: 'tabler:circle-check',
  },
  {
    title: 'Seamless Cross-Device Sync (Zero-Knowledge E2EE)',
    description:
      'Keep your tasks and notes synchronized in real-time across Mac, Windows, Linux, iPhone, iPad, and Android with instant 6-digit device pairing codes. Client-side AES-256-GCM encryption ensures your data is never readable by servers.',
    icon: 'tabler:devices',
  },
  {
    title: 'Smart Scheduling & Next-Day / Next-Week Deferral',
    description:
      'Schedule tasks for Today, Tomorrow, or specific weekdays with 1-click "Next Day" and "Next Week" quick buttons. Set automated recurring tasks that roll over automatically upon completion.',
    icon: 'tabler:calendar-repeat',
  },
  {
    title: 'Photo Attachments & Clipboard Screen Grabs',
    description:
      'Attach up to 3 photos per note! Drag and drop files, paste clipboard screenshots instantly (⌘V / Ctrl+V) for work mockups and documentation, or snap receipts and whiteboard notes on mobile with full-screen Lightbox zoom.',
    icon: 'tabler:photo',
  },
  {
    title: 'Dual Skin Modes: Task Manager vs. Rapid Voice Notes',
    description:
      'Switch instantly between a structured Task Manager (P1-P4 matrix for office focus and sprint planning) and a Simple Voice Notes mode with extra-large text and hands-free dictation for rapid thought capture away from your desk.',
    icon: 'tabler:transform',
  },
  {
    title: 'Continuous Voice Dictation & Spoken Commands',
    description:
      'Dictate tasks, meeting action items, and notes naturally on the go. Auto-formats spoken punctuation ("comma", "full stop"), auto-capitalizes sentences, and auto-saves hands-free by saying "add task" or "add note".',
    icon: 'tabler:microphone',
  },
];

const additionalFeatures = [
  {
    title: 'Drag-and-Drop Subtasks & Line Wrapping',
    description:
      'Break large goals into multi-line checklist steps. Easily reorder subtasks via drag-and-drop handles and preview progress bars directly on task cards.',
    icon: 'tabler:list-check',
  },
  {
    title: 'Color-Coded Projects & Kanban Column Views',
    description:
      'Organize tasks into custom project folders with custom colors. On desktop wide screens, view your workspace grouped either by Priority tiers or Project Kanban columns.',
    icon: 'tabler:folder',
  },
  {
    title: 'Universal 1-Click Multi-Competitor Importer',
    description:
      'Switch away from paid tools in seconds. Easily import your entire setup from Todoist (CSV), TickTick (Backup CSV), Google Keep (JSON), Google Tasks (JSON), and Microsoft To Do (CSV).',
    icon: 'tabler:file-import',
  },
  {
    title: 'Built-In Resilience, Photo Backups & Autonomous Shadow Snapshots',
    description:
      'Never lose work to silent browser updates, unexpected reboots, or disk cleanups. Features immediate synchronous disk saving, dual-tier photo preservation (full-res in IndexedDB + thumbnails in shadow backups to prevent 5MB storage crashes), HTML5 Persistent Storage API protection, and automatic 24-hour local shadow snapshots.',
    icon: 'tabler:shield-check',
  },
  {
    title: '100% Offline Progressive Web App (PWA)',
    description:
      'Install 123 ToDo directly to your mobile home screen or desktop. Works completely offline with native app speed, zero network lag, and silent background updates without annoying prompts.',
    icon: 'tabler:device-mobile-check',
  },
  {
    title: 'Space-Efficient Note Previews & 2-Line Compact View',
    description:
      'Choose between a clean 2-line compact task preview or full-length view. Tasks with notes display a space-saving single-line preview underneath the title for effortless scanning.',
    icon: 'tabler:notes',
  },
  {
    title: '10-Tier Milestones & Gamified Productivity Points',
    description:
      'Earn points (+10 task, +2 subtask, +15 streak) and advance through 10 progressive achievement ranks from Focused Starter 🌱 to 123 Immortal 👑 with milestone badges and streak tracking.',
    icon: 'tabler:trophy',
  },
  {
    title: 'Never-Break-the-Chain Daily Streaks',
    description:
      'Build compounding daily productivity habits. Track your active daily completion streak and celebrate milestone achievements in the header.',
    icon: 'tabler:flame',
  },
  {
    title: 'Free to Use — No Hidden Subscriptions or Ads',
    description:
      'Enjoy uncapped tasks, unlimited projects, unlimited note lengths, photo attachments, and full sync features with no forced subscriptions, ads, or tracking.',
    icon: 'tabler:currency-dollar-off',
  },
];

const faqs = [
  {
    question: 'Is 123 ToDo really 100% free with no hidden subscriptions?',
    answer:
      'Yes! All core productivity features—including uncapped tasks, photo attachments, voice dictation, subtask checklists, and cross-device zero-knowledge sync—are 100% free to use. There are no 14-day trial paywalls, no credit card requirements, and no third-party advertisements.',
  },
  {
    question: 'How does 123 ToDo compare to Todoist, TickTick, and Google Keep?',
    answer:
      'Unlike Todoist and TickTick that charge $36–$72/year for photo uploads, reminders, and daily backups, 123 ToDo provides these capabilities completely free. Unlike Google Keep or Microsoft To Do, 123 ToDo features true client-side zero-knowledge AES-256-GCM encryption, meaning your personal tasks and private notes are never scanned, indexed, or monetized.',
  },
  {
    question: 'Can I sync my tasks across Mac, Windows, Linux, iOS, and Android?',
    answer:
      'Absolutely. 123 ToDo syncs in real-time across all your devices using our Set & Forget Cloud Sync (powered by Cloudflare D1 edge database) or Google Drive Sync. You pair your phone, tablet, and computer using secure 6-digit device pairing codes without persistent login drops.',
  },
  {
    question: 'Will I lose any tasks or photos if my browser updates silently or my computer restarts?',
    answer:
      'No. 123 ToDo writes all changes synchronously and immediately to physical local storage. Browser executable updates (Chrome, Safari, Edge) do not touch your user profile storage directory. Furthermore, 123 ToDo includes automatic 24-hour shadow snapshots, HTML5 Persistent Storage protection, and dual-tier photo preservation (full-resolution in IndexedDB and compressed thumbnail shadows in LocalStorage) to prevent data loss.',
  },
  {
    question: 'How does the Dual Skins (Task Manager vs. Voice Notes) mode work?',
    answer:
      'With a single tap on the header toggle, you can switch between Task Manager mode (a structured priority matrix with subtasks, due dates, and project folders for office work and sprint planning) and Simple Voice Notes mode (extra-large high-contrast text and instant hands-free speech dictation for rapid thought capture away from your desk). Both modes share the exact same underlying dataset.',
  },
  {
    question: 'Does 123 ToDo work completely offline?',
    answer:
      'Yes. 123 ToDo is an offline-first Progressive Web App (PWA). You can install it directly to your home screen or desktop dock. You can create, edit, reschedule, or complete tasks with zero internet connection, and your changes will automatically sync once your connection is restored.',
  },
  {
    question: 'How do I import my existing tasks from another to-do app?',
    answer:
      'You can migrate your entire setup in seconds using our universal 1-click competitor importer. We provide native support for Todoist (CSV), TickTick (Backup CSV), Google Keep (JSON), Google Tasks (JSON), and Microsoft To Do (CSV).',
  },
];

const metadata = {
  title: '123 ToDo - Free Task Manager, Daily To-Do List App & Voice Notes App (Best Todoist & TickTick Alternative)',
  description:
    '123 ToDo is a fast, 100% free task manager and to-do list app with voice notes, photo attachments, subtasks, daily streaks, zero-knowledge encryption, and 1-click migration from Todoist, TickTick, Google Keep, and Microsoft To Do.',
  ignoreTitleTemplate: true,
  openGraph: {
    images: [
      {
        url: '~/assets/images/og-social-share.jpg',
        width: 1200,
        height: 630,
        alt: '123 ToDo - Free Task Manager, To-Do List App & Private Voice Notes',
      },
    ],
    type: 'website',
  },
  twitter: {
    cardType: 'summary_large_image',
  },
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Launch App',
        href: 'https://app.123todo.com',
        target: '_blank',
      },
      {
        text: 'Try Interactive Demo',
        href: '#interactive-demo',
        id: 'hero-open-demo-btn',
      },
    ]}
  >
    <Fragment slot="title">
      123 ToDo — The Free, Private<br class="hidden sm:inline" />
      <span class="text-accent dark:text-white highlight inline-block">Task Manager &amp; To-Do List&nbsp;App</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="text-lg text-balance block max-w-3xl mx-auto">
        <span class="font-semibold text-accent dark:text-white"
          >Works across Mac, Windows, Linux, iOS, Android &amp; Web with Zero-Knowledge Cloud&nbsp;Sync.</span
        >
        <span class="text-purple-600 dark:text-purple-400 font-bold underline decoration-2 underline-offset-4"
          >100% FREE.</span
        > The private, offline-first alternative to Todoist, TickTick, Google Keep, and Microsoft To&nbsp;Do.
      </span>
    </Fragment>

    <Fragment slot="content">
      <!-- Trust Reassurance Microcopy -->
      <div
        class="mt-4 mb-2 flex flex-wrap items-center justify-center gap-x-4 gap-y-1.5 text-xs sm:text-sm font-medium text-slate-600 dark:text-slate-300"
      >
        <span class="inline-flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-semibold">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg
          >
          No sign-up or email
        </span>
        <span class="text-slate-300 dark:text-slate-600 hidden sm:inline">•</span>
        <span class="inline-flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-semibold">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg
          >
          No credit card
        </span>
        <span class="text-slate-300 dark:text-slate-600 hidden sm:inline">•</span>
        <span class="inline-flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-semibold">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg
          >
          Opens instantly in browser
        </span>
        <span class="text-slate-300 dark:text-slate-600 hidden sm:inline">•</span>
        <span class="inline-flex items-center gap-1.5 text-blue-600 dark:text-blue-400 font-semibold">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
            ></path></svg
          >
          100% Client-Side Private
        </span>
      </div>
    </Fragment>

    <Fragment slot="image">
      <div id="interactive-demo" class="scroll-mt-24 pt-4">
        <HeroInteractiveDemo client:load />
      </div>
    </Fragment>
  </Hero>

  <!-- Dual Skins Showcase (Structured Task Manager + Voice Notes) -->
  <Content
    tagline="Versatile Operating System"
    title="One Free App, Two Powerful Modes"
    items={[
      {
        title: '📋 Structured Task Manager Mode',
        description:
          'High-clarity 1-2-3 priority matrix (Must Do P1, Should Do P2, Could Do P3, On Hold P4) with subtask checklists, due dates, drag-and-drop reordering, and project categorization engineered for busy office professionals and knowledge workers.',
      },
      {
        title: '🎙️ Rapid Voice Notes Mode',
        description:
          'Extra-large text, high contrast, and instant hands-free speech dictation. Capture meeting action items, project thoughts, or voice memos immediately when away from your desk without upfront tagging.',
      },
      {
        title: '🔄 Unified Cross-Platform Dataset',
        description:
          'Switch skins instantly with a 1-tap header toggle. All notes and tasks live in the exact same dataset and sync automatically across all your devices via zero-knowledge Cloudflare D1 or Google Drive sync.',
      },
    ]}
    image={{
      src: '~/assets/images/Notes_grab.png',
      alt: '123 ToDo Dual Skins feature showing Task Manager Mode and Simple Voice Notes Mode',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2 text-balance">
        Engineered for deep focus &amp; executive&nbsp;clarity
      </h3>
      <p class="text-lg text-balance">
        Whether you are at your desk planning sprints and managing deliverables, or in transit capturing rapid voice
        memos, 123 ToDo adapts to your workday seamlessly.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50/50 dark:bg-slate-900/50"></div>
    </Fragment>
  </Content>

  <!-- Non-Technical Life Benefits Section -->
  <section
    class="relative bg-gradient-to-b from-blue-50/70 to-white dark:from-slate-900/60 dark:to-slate-900 not-prose py-12 md:py-16 border-y border-slate-100 dark:border-slate-800"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-10 md:mb-14">
        <p class="text-base text-accent dark:text-blue-400 font-bold tracking-wide uppercase">Why Choose 123 ToDo?</p>
        <h2
          class="text-3xl md:text-5xl font-bold font-heading tracking-tight text-heading dark:text-white mt-2 mb-4 text-balance"
        >
          Turn Daily Chaos into Calm &amp;&nbsp;Clarity
        </h2>
        <p class="text-xl text-muted dark:text-slate-300 max-w-2xl mx-auto text-balance">
          Discover how effortless organization frees your mind, eliminates daily overwhelm, and helps you reclaim
          control over your&nbsp;time.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
        <!-- Benefit Card 1 -->
        <div
          class="bg-white dark:bg-slate-800/90 p-6 md:p-8 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/80 hover:shadow-md transition duration-200 flex flex-col"
        >
          <div
            class="w-14 h-14 bg-red-100 dark:bg-red-950/60 rounded-xl flex items-center justify-center mb-5 text-red-600 dark:text-red-400"
          >
            <svg
              class="w-8 h-8"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z"></path>
              <path d="M12 7v5l3 3"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 text-balance">De-Stress Your&nbsp;Mind</h3>
          <p class="text-muted dark:text-slate-300 leading-relaxed text-sm md:text-base flex-1">
            Stop keeping tasks trapped in your head. Offload to-dos instantly into organized lists so you can relax,
            focus, and enjoy your day without burnout.
          </p>
        </div>

        <!-- Benefit Card 2 -->
        <div
          class="bg-white dark:bg-slate-800/90 p-6 md:p-8 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/80 hover:shadow-md transition duration-200 flex flex-col"
        >
          <div
            class="w-14 h-14 bg-amber-100 dark:bg-amber-950/60 rounded-xl flex items-center justify-center mb-5 text-amber-600 dark:text-amber-400"
          >
            <svg
              class="w-8 h-8"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <circle cx="12" cy="12" r="6"></circle>
              <circle cx="12" cy="12" r="2"></circle>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 text-balance">
            Clear Daily 1-2-3&nbsp;Priorities
          </h3>
          <p class="text-muted dark:text-slate-300 leading-relaxed text-sm md:text-base flex-1">
            Focus on what truly matters today using 4 simple buckets: Must Do (P1), Should Do (P2), Could Do (P3), and
            On Hold. Eliminate decision fatigue instantly.
          </p>
        </div>

        <!-- Benefit Card 3 -->
        <div
          class="bg-white dark:bg-slate-800/90 p-6 md:p-8 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/80 hover:shadow-md transition duration-200 flex flex-col"
        >
          <div
            class="w-14 h-14 bg-emerald-100 dark:bg-emerald-950/60 rounded-xl flex items-center justify-center mb-5 text-emerald-600 dark:text-emerald-400"
          >
            <svg
              class="w-8 h-8"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 text-balance">Reclaim Free&nbsp;Time</h3>
          <p class="text-muted dark:text-slate-300 leading-relaxed text-sm md:text-base flex-1">
            When your day is organized, tasks get done faster. Finish work earlier, avoid last-minute rushes, and make
            room for family, hobbies, and rest.
          </p>
        </div>

        <!-- Benefit Card 4 -->
        <div
          class="bg-white dark:bg-slate-800/90 p-6 md:p-8 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/80 hover:shadow-md transition duration-200 flex flex-col"
        >
          <div
            class="w-14 h-14 bg-purple-100 dark:bg-purple-950/60 rounded-xl flex items-center justify-center mb-5 text-purple-600 dark:text-purple-400"
          >
            <svg
              class="w-8 h-8"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 text-balance">
            100% Free, Instant&nbsp;Start
          </h3>
          <p class="text-muted dark:text-slate-300 leading-relaxed text-sm md:text-base flex-1">
            No registration, no passwords, no email verification, and no credit card required. Open the app and be
            organized in under 60 seconds.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section with Progressive Disclosure -->
  <WidgetWrapper id="features" containerClass="max-w-6xl !py-8 md:!py-12">
    <Headline
      tagline="Features & Capabilities"
      title="Everything You Need in a Modern To-Do & Notes App"
      subtitle="Engineered for ultimate simplicity, zero-knowledge privacy, and daily productivity flow"
      classes={{
        title: 'text-3xl md:text-4xl text-balance',
        subtitle: 'text-xl text-balance max-w-2xl mx-auto',
      }}
    />

    <!-- Top 6 Core Features Requested by User -->
    <ItemGrid
      items={coreFeatures}
      columns={2}
      classes={{
        container: 'gap-x-8 gap-y-10',
        title: 'md:text-[1.25rem] font-bold text-slate-900 dark:text-white',
        description: 'text-slate-600 dark:text-slate-300 text-sm md:text-base leading-relaxed',
        icon: 'text-white bg-blue-600 rounded-xl w-10 h-10 md:w-12 md:h-12 p-2.5 mr-4 shadow-sm flex-shrink-0',
      }}
    />

    <!-- Progressive Disclosure Expander for Additional 8 Features -->
    <div class="mt-10 pt-2">
      <details
        class="group rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900/50 overflow-hidden transition-all duration-300 shadow-sm"
      >
        <summary
          class="flex items-center justify-between gap-4 p-5 sm:px-6 cursor-pointer select-none text-slate-800 dark:text-slate-200 hover:bg-blue-50/50 dark:hover:bg-slate-800/60 transition-colors list-none [&::-webkit-details-marker]:hidden"
        >
          <div class="flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
            <span class="font-bold text-sm sm:text-base tracking-wide">
              <span class="group-open:hidden">Show 8 More Features &amp; Capabilities</span>
              <span class="hidden group-open:inline">Hide Additional Features &amp; Specifications</span>
            </span>
            <span
              class="text-xs px-2.5 py-0.5 rounded-full bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-300 font-semibold hidden sm:inline-block"
            >
              All Included Free
            </span>
          </div>
          <div class="flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-blue-600 dark:text-blue-400">
            <span class="group-open:hidden">Show All ▾</span>
            <span class="hidden group-open:inline">Collapse ▴</span>
          </div>
        </summary>
        <div class="p-6 sm:p-8 pt-6 border-t border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/70">
          <ItemGrid
            items={additionalFeatures}
            columns={2}
            classes={{
              container: 'gap-x-8 gap-y-10',
              title: 'md:text-[1.25rem] font-bold text-slate-900 dark:text-white',
              description: 'text-slate-600 dark:text-slate-300 text-sm md:text-base leading-relaxed',
              icon: 'text-white bg-slate-700 dark:bg-slate-700 rounded-xl w-10 h-10 md:w-12 md:h-12 p-2.5 mr-4 shadow-sm flex-shrink-0',
            }}
          />
        </div>
      </details>
    </div>
  </WidgetWrapper>

  <!-- How It Works -->
  <Content
    isReversed
    tagline="How It Works"
    title="Get Organized in 3 Simple Steps"
    items={[
      {
        title: '1. Add Tasks, Photos, or Voice Notes',
        description:
          'Quickly type, speak, or snap photos for your tasks. Attach checklist subtasks or rich notes with zero limits.',
      },
      {
        title: '2. Set Daily 1-2-3 Priorities',
        description:
          'Organize your workload into Must Do (1), Should Do (2), and Could Do (3) buckets. Drag and drop to reorder tasks or defer with 1 tap.',
      },
      {
        title: '3. Complete, Level Up & Build Streaks',
        description:
          'Check off completed tasks to earn Productivity Points, maintain your daily focus streak, and advance through 10 progressive achievement ranks!',
      },
    ]}
    image={{
      src: '~/assets/images/new_grab.jpg',
      alt: '123 ToDo app screenshot showing modern task management and priorities',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2 text-balance">
        No learning curve&nbsp;required
      </h3>
      <p class="text-lg text-balance">
        Start managing your tasks immediately. 123 ToDo is designed to be intuitive and straightforward, so you can
        focus on getting things done instead of configuring complex software.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Competitor Comparison Section: Best Free Alternative -->
  <section class="py-12 md:py-16 bg-slate-50 dark:bg-slate-900/60 border-y border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-10 md:mb-12">
        <p class="text-base text-accent dark:text-blue-400 font-bold tracking-wide uppercase">App Comparison</p>
        <h2
          class="text-3xl md:text-4xl font-bold font-heading tracking-tight text-heading dark:text-white mt-2 mb-4 text-balance"
        >
