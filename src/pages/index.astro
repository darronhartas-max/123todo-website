---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import HeroInteractiveDemo from '~/components/interactive/HeroInteractiveDemo';

const metadata = {
  title: '123 ToDo - Free Task Manager, Daily To-Do List App & Voice Notes App (Best Todoist & TickTick Alternative)',
  description:
    '123 ToDo is a fast, 100% free task manager and to-do list app with voice notes, photo attachments, subtasks, daily streaks, zero-knowledge encryption, and 1-click migration from Todoist, TickTick, Google Keep, and Microsoft To Do.',
  ignoreTitleTemplate: true,
  openGraph: {
    images: [
      {
        url: '~/assets/images/og-social-share.jpg',
        width: 1200,
        height: 630,
        alt: '123 ToDo - Free Task Manager, To-Do List App & Private Voice Notes',
      },
    ],
    type: 'website',
  },
  twitter: {
    cardType: 'summary_large_image',
  },
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Launch App',
        href: 'https://app.123todo.com',
        target: '_blank',
      },
      {
        text: 'Try Interactive Demo',
        href: '#interactive-demo',
        id: 'hero-open-demo-btn',
      },
    ]}
  >
    <Fragment slot="title">
      123 ToDo — The Free, Private<br class="hidden sm:inline" />
      <span class="text-accent dark:text-white highlight inline-block">Task Manager &amp; To-Do List&nbsp;App</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="text-lg text-balance block max-w-3xl mx-auto">
        <span class="font-semibold text-accent dark:text-white"
          >Works across Mac, Windows, Linux, iOS, Android &amp; Web with Zero-Knowledge Cloud&nbsp;Sync.</span
        >
        <span class="text-purple-600 dark:text-purple-400 font-bold underline decoration-2 underline-offset-4"
          >100% FREE.</span
        > The private, offline-first alternative to Todoist, TickTick, Google Keep, and Microsoft To&nbsp;Do.
      </span>
    </Fragment>

    <Fragment slot="content">
      <!-- Trust Reassurance Microcopy -->
      <div
        class="mt-4 mb-2 flex flex-wrap items-center justify-center gap-x-4 gap-y-1.5 text-xs sm:text-sm font-medium text-slate-600 dark:text-slate-300"
      >
        <span class="inline-flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-semibold">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg
          >
          No sign-up or email
        </span>
        <span class="text-slate-300 dark:text-slate-600 hidden sm:inline">•</span>
        <span class="inline-flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-semibold">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg
          >
          No credit card
        </span>
        <span class="text-slate-300 dark:text-slate-600 hidden sm:inline">•</span>
        <span class="inline-flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-semibold">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg
          >
          Opens instantly in browser
        </span>
        <span class="text-slate-300 dark:text-slate-600 hidden sm:inline">•</span>
        <span class="inline-flex items-center gap-1.5 text-blue-600 dark:text-blue-400 font-semibold">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
            ></path></svg
          >
          100% Client-Side Private
        </span>
      </div>

      <div class="mt-6 pt-5 border-t border-slate-200/80 dark:border-slate-800 max-w-2xl mx-auto">
        <p class="text-xs uppercase tracking-wider font-bold text-slate-500 dark:text-slate-400 mb-2.5">
          ⚡ Available Everywhere — 100% Free &amp; Offline-Ready
        </p>
        <div
          class="flex flex-wrap items-center justify-center gap-2 sm:gap-2.5 text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-200"
        >
          <span
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm"
          >
            🍏 Mac
          </span>
          <span
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm"
          >
            🪟 Windows
          </span>
          <span
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm"
          >
            🐧 Linux
          </span>
          <span
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm"
          >
            📱 iOS (iPhone &amp; iPad)
          </span>
          <span
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm"
          >
            🤖 Android
          </span>
          <span
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800/80 shadow-sm"
          >
            🌐 Any Web Browser
          </span>
        </div>
        <p class="text-xs text-muted dark:text-slate-400 mt-2.5">
          Instant Web App • Installable PWA • Real-time Zero-Knowledge Sync across all your devices
        </p>
      </div>
    </Fragment>

    <Fragment slot="image">
      <div id="interactive-demo" class="scroll-mt-24 pt-4">
        <HeroInteractiveDemo client:load />
      </div>
    </Fragment>
  </Hero>

  <!-- New Feature Promo Banner -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 -mt-4 mb-8">
    <a
      href="/guide"
      class="flex flex-col sm:flex-row items-center justify-between gap-3 p-4 bg-gradient-to-r from-blue-600 via-indigo-600 to-sky-600 rounded-2xl text-white shadow-lg shadow-blue-500/20 hover:shadow-xl hover:scale-[1.01] transition duration-200"
    >
      <div class="flex items-center gap-3">
        <span
          class="bg-white/20 text-white text-xs uppercase font-bold tracking-wider px-2.5 py-1 rounded-full border border-white/30 backdrop-blur-sm"
          >NEW v3.7.0</span
        >
        <span class="font-medium text-sm sm:text-base text-balance"
          >🕒 1-Click Timestamped Notes &amp; Activity Logs, Visible Creation Times, and Photo Attachments are live!</span
        >
      </div>
      <span
        class="text-xs sm:text-sm font-semibold bg-white text-blue-700 px-3.5 py-1.5 rounded-xl whitespace-nowrap flex items-center gap-1 shadow-sm"
        >Explore Guide &rarr;</span
      >
    </a>
  </div>

  <!-- Dual Skins Showcase (Moved up right after hero/banner for immediate visual impact) -->
  <Content
    tagline="Versatile Operating System"
    title="One Free App, Two Powerful Modes"
    items={[
      {
        title: '🎙️ Simple Voice Notes Mode',
        description:
          'Extra-large text, high contrast, and rapid voice dictation controls designed for builders, contractors, and busy professionals on site. Speak measurements, materials, or updates hands-free without worrying about project tagging upfront.',
      },
      {
        title: '📋 Task Manager Mode',
        description:
          'Structured priority matrix (Must Do P1, Should Do P2, Could Do P3, On Hold P4) with subtask checklists, due dates, drag-and-drop reordering, and attached notes.',
      },
      {
        title: '🔄 Unified Cross-Platform Dataset',
        description:
          'Switch skins at will with a 1-tap header toggle. All notes and tasks live in the exact same dataset and sync automatically across all your devices via zero-knowledge Cloudflare D1 or Google Drive sync.',
      },
    ]}
    image={{
      src: '~/assets/images/Notes_grab.png',
      alt: '123 ToDo Dual Skins feature showing Task Manager Mode and Simple Voice Notes Mode',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2 text-balance">
        Designed for both field work &amp; office&nbsp;focus
      </h3>
      <p class="text-lg text-balance">
        Whether you are on a construction site taking quick site measurements or at your desk planning your week, 123
        ToDo adapts to your workflow seamlessly.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50/50 dark:bg-slate-900/50"></div>
    </Fragment>
  </Content>

  <!-- Prompt 1: Try Dual Skins -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 my-8">
    <div
      class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 rounded-2xl p-6 sm:p-8 text-white shadow-xl flex flex-col md:flex-row items-center justify-between gap-6"
    >
      <div class="text-center md:text-left">
        <span
          class="bg-white/20 text-white text-xs uppercase font-bold tracking-wider px-3 py-1 rounded-full border border-white/30 backdrop-blur-sm inline-block mb-2"
          >Instant Free Access</span
        >
        <h3 class="text-2xl sm:text-3xl font-bold font-heading text-balance">
          Ready to Try Voice Notes &amp; Task&nbsp;Management?
        </h3>
        <p class="text-blue-100 text-sm sm:text-base mt-1 text-balance">
          Open in your browser now on any device — No account, no credit card, no downloads required.
        </p>
      </div>
      <a
        href="https://app.123todo.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-white text-blue-700 hover:bg-blue-50 font-bold px-6 py-3.5 rounded-xl text-base shadow-md hover:scale-105 transition-all duration-200 whitespace-nowrap flex-shrink-0"
      >
        <span>Start Using 123 ToDo Free</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
          ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"
          ></path></svg
        >
      </a>
    </div>
  </div>

  <!-- Non-Technical Life Benefits Section -->
  <section
    class="relative bg-gradient-to-b from-blue-50/70 to-white dark:from-slate-900/60 dark:to-slate-900 not-prose py-12 md:py-16 border-y border-slate-100 dark:border-slate-800"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-10 md:mb-14">
        <p class="text-base text-accent dark:text-blue-400 font-bold tracking-wide uppercase">Why Choose 123 ToDo?</p>
        <h2
          class="text-3xl md:text-5xl font-bold font-heading tracking-tight text-heading dark:text-white mt-2 mb-4 text-balance"
        >
          Turn Daily Chaos into Calm &amp;&nbsp;Clarity
        </h2>
        <p class="text-xl text-muted dark:text-slate-300 max-w-2xl mx-auto text-balance">
          Discover how effortless organization frees your mind, eliminates daily overwhelm, and helps you reclaim
          control over your&nbsp;time.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
        <!-- Benefit Card 1 -->
        <div
          class="bg-white dark:bg-slate-800/90 p-6 md:p-8 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/80 hover:shadow-md transition duration-200 flex flex-col"
        >
          <div
            class="w-14 h-14 bg-red-100 dark:bg-red-950/60 rounded-xl flex items-center justify-center mb-5 text-red-600 dark:text-red-400"
          >
            <svg
              class="w-8 h-8"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z"></path>
              <path d="M12 7v5l3 3"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 text-balance">De-Stress Your&nbsp;Mind</h3>
          <p class="text-muted dark:text-slate-300 leading-relaxed text-sm md:text-base flex-1">
            Stop keeping tasks trapped in your head. Offload to-dos instantly into organized lists so you can relax,
            focus, and enjoy your day without burnout.
          </p>
        </div>

        <!-- Benefit Card 2 -->
        <div
          class="bg-white dark:bg-slate-800/90 p-6 md:p-8 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/80 hover:shadow-md transition duration-200 flex flex-col"
        >
          <div
            class="w-14 h-14 bg-amber-100 dark:bg-amber-950/60 rounded-xl flex items-center justify-center mb-5 text-amber-600 dark:text-amber-400"
          >
            <svg
              class="w-8 h-8"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <circle cx="12" cy="12" r="6"></circle>
              <circle cx="12" cy="12" r="2"></circle>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 text-balance">
            Clear Daily 1-2-3&nbsp;Priorities
          </h3>
          <p class="text-muted dark:text-slate-300 leading-relaxed text-sm md:text-base flex-1">
            Focus on what truly matters today using 4 simple buckets: Must Do (P1), Should Do (P2), Could Do (P3), and
            On Hold. Eliminate decision fatigue instantly.
          </p>
        </div>

        <!-- Benefit Card 3 -->
        <div
          class="bg-white dark:bg-slate-800/90 p-6 md:p-8 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/80 hover:shadow-md transition duration-200 flex flex-col"
        >
          <div
            class="w-14 h-14 bg-emerald-100 dark:bg-emerald-950/60 rounded-xl flex items-center justify-center mb-5 text-emerald-600 dark:text-emerald-400"
          >
            <svg
              class="w-8 h-8"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 text-balance">Reclaim Free&nbsp;Time</h3>
          <p class="text-muted dark:text-slate-300 leading-relaxed text-sm md:text-base flex-1">
            When your day is organized, tasks get done faster. Finish work earlier, avoid last-minute rushes, and make
            room for family, hobbies, and rest.
          </p>
        </div>

        <!-- Benefit Card 4 -->
        <div
          class="bg-white dark:bg-slate-800/90 p-6 md:p-8 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/80 hover:shadow-md transition duration-200 flex flex-col"
        >
          <div
            class="w-14 h-14 bg-purple-100 dark:bg-purple-950/60 rounded-xl flex items-center justify-center mb-5 text-purple-600 dark:text-purple-400"
          >
            <svg
              class="w-8 h-8"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 text-balance">
            100% Free, Instant&nbsp;Start
          </h3>
          <p class="text-muted dark:text-slate-300 leading-relaxed text-sm md:text-base flex-1">
            No registration, no passwords, no email verification, and no credit card required. Open the app and be
            organized in under 60 seconds.
          </p>
        </div>
      </div>

      <!-- Prompt 2: De-stress Action Strip -->
      <div class="mt-10 text-center">
        <div
          class="inline-flex flex-col sm:flex-row items-center gap-4 p-3 sm:px-6 bg-white dark:bg-slate-800 rounded-2xl shadow-md border border-slate-200 dark:border-slate-700"
        >
          <span class="text-sm sm:text-base font-semibold text-slate-800 dark:text-slate-200">
            ✨ Why wait? De-stress your day in under 60&nbsp;seconds.
          </span>
          <a
            href="https://app.123todo.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm px-5 py-2.5 rounded-xl shadow-sm transition-all duration-200 whitespace-nowrap"
          >
            <span>Open Web App — 100% Free</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg
            >
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section (Re-ordered with high-utility daily tools first) -->
  <Features
    id="features"
    tagline="Features & Capabilities"
    title="Everything You Need in a Modern To-Do App"
    subtitle="Engineered for ultimate simplicity, zero-knowledge privacy, and daily productivity flow"
    classes={{
      container: '!py-6 md:!py-8',
      headline: {
        title: 'text-3xl md:text-4xl text-balance',
        subtitle: 'text-xl text-balance max-w-2xl mx-auto',
      },
    }}
    items={[
      {
        title: '📸 Photo Attachments & Clipboard Screen Grabs',
        description:
          'Attach up to 3 photos per note! Capture site photos and receipts directly via camera on mobile, drag-and-drop files, or paste screenshots instantly from your clipboard (Cmd+V / Ctrl+V) with full-screen Lightbox zoom.',
        icon: 'tabler:photo',
      },
      {
        title: '🎙️ Dual Skin Modes: Task Manager vs. Simple Voice Notes',
        description:
          'Switch instantly between a structured Task Manager (P1-P4 matrix) and a Simple Voice Notes mode with extra-large text, instant hands-free dictation, and unassigned inbox triage for field contractors & trades.',
        icon: 'tabler:transform',
      },
      {
        title: '🎤 Continuous Voice Dictation & Spoken Commands',
        description:
          'Dictate tasks & notes naturally on the go. Auto-formats spoken punctuation ("comma", "full stop"), auto-capitalizes sentences, and auto-saves hands-free by saying "add task" or "add note".',
        icon: 'tabler:microphone',
      },
      {
        title: '🛡️ Zero-Knowledge E2EE Cloud Sync',
        description:
          'Keep your tasks synchronized in real-time across iPhone, iPad, Android, Mac, and Windows PC. Powered by client-side AES-256-GCM encryption with 6-digit device pairing codes.',
        icon: 'tabler:shield-lock',
      },
      {
        title: '📋 Drag-and-Drop Subtasks & Line Wrapping',
        description:
          'Break large goals into multi-line checklist steps. Easily reorder subtasks via drag-and-drop handles and preview progress bars directly on task cards.',
        icon: 'tabler:list-check',
      },
      {
        title: '📅 Smart Scheduling & Next-Day / Next-Week Deferral',
        description:
          'Schedule tasks for Today, Tomorrow, or specific weekdays with 1-click "Next Day" and "Next Week" quick buttons. Set automated recurring tasks that roll over automatically upon completion.',
        icon: 'tabler:calendar-repeat',
      },
      {
        title: '🎨 Color-Coded Projects & Kanban Column Views',
        description:
          'Organize tasks into custom project folders with custom colors. On desktop wide screens, view your workspace grouped either by Priority tiers or Project Kanban columns.',
        icon: 'tabler:folder',
      },
      {
        title: '📦 Universal 1-Click Multi-Competitor Importer',
        description:
          'Switch away from paid tools in seconds. Easily import your entire setup from Todoist (CSV), TickTick (Backup CSV), Google Keep (JSON), Google Tasks (JSON), and Microsoft To Do (CSV).',
        icon: 'tabler:file-import',
      },
      {
        title: '⚡ 100% Offline Progressive Web App (PWA)',
        description:
          'Install 123 ToDo directly to your mobile home screen or desktop. Works completely offline with 24-hour automated local shadow backups and persistent storage protection.',
        icon: 'tabler:device-mobile-check',
      },
      {
        title: '🔍 Space-Efficient Note Previews & 2-Line Compact View',
        description:
          'Choose between a clean 2-line compact task preview or full-length view. Tasks with notes display a space-saving single-line preview underneath the title for effortless scanning.',
        icon: 'tabler:notes',
      },
      {
        title: '🏆 10-Tier Milestones & Gamified Productivity Points',
        description:
          'Earn points (+10 task, +2 subtask, +15 streak) and advance through 10 progressive achievement ranks from Focused Starter 🌱 to 123 Immortal 👑 with milestone badges and streak tracking.',
        icon: 'tabler:trophy',
      },
      {
        title: '🔥 Never-Break-the-Chain Daily Streaks',
        description:
          'Build compounding daily productivity habits. Track your active daily completion streak and celebrate milestone achievements in the header.',
        icon: 'tabler:flame',
      },
      {
        title: '💸 Free to Use — No Hidden Subscriptions',
        description:
          'Enjoy uncapped tasks, unlimited projects, unlimited note lengths, photo attachments, and full sync features with no forced subscriptions, ads, or tracking.',
        icon: 'tabler:currency-dollar-off',
      },
    ]}
  />

  <!-- Prompt 3: All Features Included Free -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 -mt-2 mb-12 text-center">
    <div
      class="bg-blue-50/80 dark:bg-slate-800/80 border border-blue-200/80 dark:border-slate-700 rounded-2xl p-6 sm:p-8"
    >
      <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-2 text-balance">
        All Core Features Included Free — Get Started in Seconds
      </h3>
      <p class="text-muted dark:text-slate-300 text-sm sm:text-base max-w-xl mx-auto mb-5 text-balance">
        Photos, continuous voice dictation, subtasks, end-to-end encryption, and daily streaks are completely uncapped
        for every user.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="https://app.123todo.com"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary inline-flex items-center justify-center font-bold px-6 py-3 rounded-xl shadow-md text-base"
        >
          <span>Launch App</span>
        </a>
        <span class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 flex items-center gap-1.5 font-medium">
          ✓ Works on Mac, Windows, Linux, iOS &amp; Android
        </span>
      </div>
    </div>
  </div>

  <!-- How It Works -->
  <Content
    isReversed
