---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

const metadata = {
  title: '123 ToDo - FREE Simple, Stress-Free Task Management & Daily To-Do Lists',
  description:
    'Free, simple task manager to organize your day, track priorities, and clear mental clutter. Voice dictation, subtasks, offline PWA, and private sync.',
  ignoreTitleTemplate: true,
  openGraph: {
    images: [
      {
        url: '~/assets/images/og-social-share.jpg',
        width: 1200,
        height: 630,
        alt: '123 ToDo - Simple, Organised, Free task management',
      },
    ],
    type: 'website',
  },
  twitter: {
    cardType: 'summary_large_image',
  },
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Start Organizing',
        href: 'https://app.123todo.com',
        icon: 'tabler:rocket',
      },
      {
        text: 'Learn More',
        href: '#features',
      },
    ]}
    image={{
      src: '~/assets/images/productive-man.json',
      alt: 'Person organizing tasks with 123 ToDo - effective time management',
    }}
  >
    <Fragment slot="title">
      Simple, Stress-Free <br />
      <span class="text-accent dark:text-white highlight">Task Management</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="text-lg">
        The simple, stress-free way to organize your day, track your to-dos, and clear mental clutter. <br />
        <span class="font-semibold text-accent dark:text-white"
          >Syncs smoothly across all your devices, with 100% data privacy.</span
        >
        <span class="text-purple-600 dark:text-purple-400 font-bold underline decoration-2 underline-offset-4"
          >100% FREE.</span
        > No signups, no passwords, no hassle.
      </span>
    </Fragment>
  </Hero>

  <!-- Non-Technical Life Benefits Section -->
  <section
    class="relative bg-gradient-to-b from-blue-50/70 to-white dark:from-slate-900/60 dark:to-slate-900 not-prose py-12 md:py-16 border-y border-slate-100 dark:border-slate-800"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-10 md:mb-14">
        <p class="text-base text-accent dark:text-blue-400 font-bold tracking-wide uppercase">Why Choose 123 ToDo?</p>
        <h2 class="text-3xl md:text-5xl font-bold font-heading tracking-tight text-heading dark:text-white mt-2 mb-4">
          Turn Daily Chaos into Calm & Clarity
        </h2>
        <p class="text-xl text-muted dark:text-slate-300">
          Discover how effortless organization frees your mind, eliminates daily overwhelm, and helps you reclaim
          control over your time.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
        <!-- Benefit Card 1 -->
        <div
          class="bg-white dark:bg-slate-800/90 p-6 md:p-8 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/80 hover:shadow-md transition duration-200 flex flex-col"
        >
          <div
            class="w-14 h-14 bg-red-100 dark:bg-red-950/60 rounded-xl flex items-center justify-center mb-5 text-red-600 dark:text-red-400"
          >
            <svg
              class="w-8 h-8"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z"></path>
              <path d="M12 7v5l3 3"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">De-Stress Your Mind</h3>
          <p class="text-muted dark:text-slate-300 leading-relaxed text-sm md:text-base flex-1">
            Stop keeping tasks trapped in your head. Offload to-dos instantly into organized lists so you can relax,
            focus, and enjoy your day.
          </p>
        </div>

        <!-- Benefit Card 2 -->
        <div
          class="bg-white dark:bg-slate-800/90 p-6 md:p-8 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/80 hover:shadow-md transition duration-200 flex flex-col"
        >
          <div
            class="w-14 h-14 bg-amber-100 dark:bg-amber-950/60 rounded-xl flex items-center justify-center mb-5 text-amber-600 dark:text-amber-400"
          >
            <svg
              class="w-8 h-8"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <circle cx="12" cy="12" r="6"></circle>
              <circle cx="12" cy="12" r="2"></circle>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Clear Daily Priorities</h3>
          <p class="text-muted dark:text-slate-300 leading-relaxed text-sm md:text-base flex-1">
            Focus on what truly matters today using 4 simple buckets: Must Do, Should Do, Could Do, and On Hold.
            Eliminate decision fatigue instantly.
          </p>
        </div>

        <!-- Benefit Card 3 -->
        <div
          class="bg-white dark:bg-slate-800/90 p-6 md:p-8 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/80 hover:shadow-md transition duration-200 flex flex-col"
        >
          <div
            class="w-14 h-14 bg-emerald-100 dark:bg-emerald-950/60 rounded-xl flex items-center justify-center mb-5 text-emerald-600 dark:text-emerald-400"
          >
            <svg
              class="w-8 h-8"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Reclaim Free Time</h3>
          <p class="text-muted dark:text-slate-300 leading-relaxed text-sm md:text-base flex-1">
            When your day is organized, tasks get done faster. Finish work earlier, avoid last-minute rushes, and make
            room for family, hobbies, and rest.
          </p>
        </div>

        <!-- Benefit Card 4 -->
        <div
          class="bg-white dark:bg-slate-800/90 p-6 md:p-8 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/80 hover:shadow-md transition duration-200 flex flex-col"
        >
          <div
            class="w-14 h-14 bg-purple-100 dark:bg-purple-950/60 rounded-xl flex items-center justify-center mb-5 text-purple-600 dark:text-purple-400"
          >
            <svg
              class="w-8 h-8"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">100% Free, Instant Start</h3>
          <p class="text-muted dark:text-slate-300 leading-relaxed text-sm md:text-base flex-1">
            No registration, no passwords, no email verification, and no credit card required. Open the app and be
            organized in under 60 seconds.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <Features
    id="features"
    tagline="Features & Benefits"
    title="Everything you need to stay organized effortlessly"
    subtitle="Designed for ultimate simplicity, privacy, and day-to-day productivity"
    classes={{
      container: '!py-6 md:!py-8',
    }}
    items={[
      {
        title: 'Voice-to-Text & Hands-Free Commands',
        description:
          'Dictate tasks & notes naturally on the go. Auto-formats spoken punctuation, auto-capitalizes sentences, and auto-saves hands-free by saying "add task" or "add note".',
        icon: 'tabler:microphone',
      },
      {
        title: '4 Simple Priority Buckets',
        description:
          'Organize tasks with our clear 4-level system: Must Do, Should Do, Could Do, and On Hold. Know exactly what to work on first.',
        icon: 'tabler:list-check',
      },
      {
        title: 'Automatic Multi-Device Sync',
        description:
          'Keep your task lists smoothly in sync across your phone, tablet, and computer using your personal Google Drive. Fast and completely free.',
        icon: 'tabler:cloud-upload',
      },
      {
        title: '100% Private & Secure',
        description:
          'Your tasks are encrypted locally before leaving your device. No corporate servers store your private notes or tracking data.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'Unlimited Notes & Subtasks',
        description:
          'Add detailed instructions, links, or checklists with zero character caps. Break big goals into easy, checkable subtask steps.',
        icon: 'tabler:notes',
      },
      {
        title: 'Works 100% Offline (PWA)',
        description:
          'Install 123ToDo on your mobile home screen or computer desktop in 1 click. Access and manage your tasks anytime without internet.',
        icon: 'tabler:device-mobile-check',
      },
      {
        title: 'Smart Dates & Repeat Rules',
        description:
          'Schedule tasks for Today, Tomorrow, or Next Week. Set automated recurring tasks for daily, weekly, or monthly routines.',
        icon: 'tabler:calendar-repeat',
      },
      {
        title: 'Color-Coded Custom Projects',
        description:
          'Organize your to-dos into custom project groups for work, home, clients, or hobbies with drag-and-drop reordering handles.',
        icon: 'tabler:folder',
      },
      {
        title: '1-Click Todoist CSV Import',
        description:
          'Switching from paid apps? Import your existing Todoist projects and tasks in under 60 seconds with zero data loss.',
        icon: 'tabler:file-import',
      },
      {
        title: 'Daily Achievement Milestones',
        description:
          'Stay inspired as you complete tasks! Unlock daily bronze, silver, and gold milestones as you complete 5, 10, or 15 items per day.',
        icon: 'tabler:trophy',
      },
    ]}
  />

  <!-- How It Works -->
  <Content
    isReversed
    tagline="How It Works"
    title="Get organized in 3 simple steps"
    items={[
      {
        title: '1. Add Your Tasks',
        description: 'Quickly add tasks with our simple interface. Each task can be up to 200 characters.',
      },
      {
        title: '2. Set Priorities',
        description:
          'Assign priority levels to organize your workload. Drag and drop to reorder lists or move tasks across priorities.',
      },
      {
        title: '3. Complete & Celebrate',
        description: 'Check off completed tasks and track your progress. Unlock achievement milestones as you go!',
      },
    ]}
    image={{
      src: '~/assets/images/new_grab.jpg',
      alt: '123 ToDo app screenshot showing modern task management',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">No learning curve required</h3>
      <p class="text-lg">
        Start managing your tasks immediately. 123 ToDo is designed to be intuitive and straightforward, so you can
        focus on getting things done instead of learning software.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Privacy Promise -->
  <Content
    tagline="Privacy First"
    title="Your data stays yours"
    items={[
      {
        title: 'Local First + Encrypted Sync',
        description:
          "Your tasks live in your browser's local storage by default. When you opt-in to sync, data is encrypted locally before being saved to your personal Google Drive.",
      },
      {
        title: 'No Registration Required',
        description:
          'No email, no password, no account. Start using immediately without giving up personal information.',
      },
      {
        title: 'Open Source Approach',
        description: "Built with transparency in mind. You can inspect the code and verify there's no tracking.",
      },
    ]}
    image={{
      src: '~/assets/images/happy-at-desk.jpg',
      alt: 'Happy person working at desk with secure task management',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Built for privacy, designed for simplicity
      </h3>
      <p class="text-lg">
        In an age of constant surveillance, 123 ToDo offers a refreshing alternative. We don't want your data, and we
        don't need it to provide you with excellent task management.
      </p>
    </Fragment>
  </Content>

  <!-- Latest Blog Posts -->
  <BlogLatestPosts
    title="Latest from our blog"
    information={`Productivity tips, feature updates, and insights on effective task management.`}
  />

  <!-- Call to Action -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get Started Now',
        href: 'https://app.123todo.com',
        icon: 'tabler:rocket',
      },
    ]}
  >
    <Fragment slot="title"> Ready to simplify your life? </Fragment>

    <Fragment slot="subtitle"> Start organizing your tasks today. No signup required, completely free. </Fragment>
  </CallToAction>
</Layout>
